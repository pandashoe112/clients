---
import Base from '../layouts/Base.astro';
import { sanity } from '../lib/sanity.js';

const settings = await sanity.fetch(`*[_type == "siteSettings"][0]{
  businessName, logo, phone, phoneHref, email, contactName,
  ratingValue, reviewCount, announcementText, serviceAreaLabel,
  footerBlurb, copyrightLine, footerNote, siteUrl
}`) || {};

const LAST_UPDATED = '14 August 2026';

// Only the head fields are needed here. Passing structuredData={false} keeps
// the business and FAQ blocks off a page that has neither.
const page = {
  seoTitle: `Privacy policy | ${settings.businessName}`,
  seoDescription: `How ${settings.businessName} collects, uses and protects the personal information you give us.`
};
---
<Base settings={settings} page={page} structuredData={false}>
  <main id="main">
    <section class="legal">
      <div class="wrap legal__inner">
        <h1>Privacy policy</h1>
        <p class="lede">
          This policy explains what personal information {settings.businessName} collects, why we
          collect it, and what we do with it. We handle personal information in line with the
          Australian Privacy Principles in the Privacy Act 1988 (Cth).
        </p>
        <p class="legal__meta">Last updated {LAST_UPDATED}</p>

        <h2>Who we are</h2>
        <p>
          {settings.businessName} is a mobile car detailing service operating across Melbourne,
          Victoria. In this policy, "we", "us" and "our" mean {settings.businessName}.
        </p>

        <h2>What we collect</h2>
        <p>When you book or enquire, we may collect:</p>
        <ul>
          <li>your name, phone number and email address</li>
          <li>your suburb or address, so we know where to bring the van</li>
          <li>details about your vehicle and the service you want</li>
          <li>anything else you tell us in the form, by text or by email, including photos of your car</li>
          <li>records of our correspondence with you</li>
        </ul>
        <p>
          We do not collect sensitive information such as health, financial account or government
          identifier details through this website. We do not take payment through this website.
        </p>

        <h2>How we collect it</h2>
        <p>
          Usually directly from you, when you fill in the booking form on this site, call us, text
          us a photo, or send us an email. We may also receive your details if someone refers you
          to us, or through a review platform you have chosen to post on.
        </p>

        <h2>Why we use it</h2>
        <ul>
          <li>to reply to your enquiry and give you a price</li>
          <li>to book, schedule and carry out the detail</li>
          <li>to invoice you and keep the records we are required to keep</li>
          <li>to arrange repeat cleans if you join the Monthly Club</li>
          <li>to improve how the website and our service work</li>
        </ul>
        <p>
          We do not sell your personal information, and we do not use it for marketing unless you
          have asked us to.
        </p>

        <h2>Who we share it with</h2>
        <p>
          We share personal information only where we need to, and only with parties who provide
          services to us. That includes the company that hosts this website and receives the
          booking form submissions, and our email provider. We may also disclose information where
          the law requires it.
        </p>
        <p>
          Some of these providers store data outside Australia. Where that happens, we take
          reasonable steps to ensure your information is handled consistently with the Australian
          Privacy Principles.
        </p>

        <h2>Cookies</h2>
        <p>
          This site does not set advertising or tracking cookies, and it does not run analytics.
          The only third parties your browser contacts are the services that deliver the fonts and
          images the page is built from.
        </p>

        <h2>How we store and protect it</h2>
        <p>
          We take reasonable steps to protect personal information from loss, misuse and
          unauthorised access, including limiting who can access it and using reputable providers
          with their own security controls. No method of transmission or storage is completely
          secure, so we cannot guarantee absolute security.
        </p>
        <p>
          We keep personal information for as long as we need it for the purposes above, or for as
          long as the law requires us to. When we no longer need it, we take reasonable steps to
          destroy or de-identify it.
        </p>

        <h2>Accessing and correcting your information</h2>
        <p>
          You can ask us for a copy of the personal information we hold about you, and ask us to
          correct it if it is wrong or out of date. Email us at
          <a href={`mailto:${settings.email}`}>{settings.email}</a> and we will respond within a
          reasonable period. We may need to verify your identity first. If we refuse a request, we
          will tell you why in writing.
        </p>

        <h2>Making a complaint</h2>
        <p>
          If you think we have mishandled your personal information, please contact us first at
          <a href={`mailto:${settings.email}`}>{settings.email}</a> so we can try to resolve it. If
          you are not satisfied with our response, you can contact the Office of the Australian
          Information Commissioner at <a href="https://www.oaic.gov.au" rel="noopener">oaic.gov.au</a>
          or on 1300 363 992.
        </p>

        <h2>Changes to this policy</h2>
        <p>
          We may update this policy from time to time. The current version is always the one on
          this page, and the date at the top tells you when it last changed.
        </p>

        <h2>Contact us</h2>
        <p>
          {settings.businessName}<br />
          Email <a href={`mailto:${settings.email}`}>{settings.email}</a><br />
          Phone <a href={`tel:${settings.phoneHref}`}>{settings.phone}</a>
        </p>
      </div>
    </section>
  </main>
</Base>

<style is:global>
  .legal { padding: 72px 0 96px; background: var(--cream); }
  .legal__inner { max-width: 760px; }
  .legal h1 { font-size: clamp(34px, 4.4vw, 50px); letter-spacing: -.03em; line-height: 1.08; }
  .legal .lede { margin-top: 20px; font-size: 18px; line-height: 1.62; color: var(--grey); }
  .legal__meta { margin: 16px 0 42px; font-size: 14.5px; color: var(--grey); }
  .legal h2 { margin: 40px 0 12px; font-size: 23px; letter-spacing: -.02em; line-height: 1.25; }
  .legal p { margin-bottom: 14px; line-height: 1.68; }
  .legal ul { margin: 0 0 14px 20px; }
  .legal li { margin-bottom: 7px; line-height: 1.6; }
  .legal a { text-decoration: underline; text-underline-offset: 3px; }
  .legal a:hover { color: var(--blue); }
</style>
