---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Included from '../components/Included.astro';
import Packages from '../components/Packages.astro';
import Addons from '../components/Addons.astro';
import Club from '../components/Club.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyUs from '../components/WhyUs.astro';
import SnapSend from '../components/SnapSend.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import Areas from '../components/Areas.astro';
import Faq from '../components/Faq.astro';
import BookForm from '../components/BookForm.astro';
import { sanity } from '../lib/sanity.js';
import { HOME_QUERY } from '../lib/queries.js';

const data = await sanity.fetch(HOME_QUERY);
const { settings = {}, page = {}, services = [], packages = [], addons = [], gallery = [], reviews = [], areas = [], faqs = [] } = data || {};
---
<Base settings={settings} page={page} faqs={faqs} packages={packages}>
  <main id="main">
    <Hero page={page} settings={settings} reviews={reviews} />
    <Intro page={page} settings={settings} />
    <Services page={page} services={services} />
    <Included page={page} settings={settings} packages={packages} />
    <Packages page={page} settings={settings} packages={packages} />
    <Addons page={page} addons={addons} />
    <Club page={page} />
    <HowItWorks page={page} />
    <WhyUs page={page} />
    <SnapSend page={page} settings={settings} />
    <Gallery page={page} gallery={gallery} />
    <Reviews page={page} settings={settings} reviews={reviews} />
    <Areas page={page} settings={settings} areas={areas} />
    <Faq page={page} faqs={faqs} />
  </main>
  <BookForm slot="book" page={page} settings={settings} />
</Base>
