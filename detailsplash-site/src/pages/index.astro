---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Included from '../components/Included.astro';
import Addons from '../components/Addons.astro';
import Club from '../components/Club.astro';
import HowItWorks from '../components/HowItWorks.astro';
import WhyUs from '../components/WhyUs.astro';
import SnapSend from '../components/SnapSend.astro';
import Gallery from '../components/Gallery.astro';
import Reviews from '../components/Reviews.astro';
import Areas from '../components/Areas.astro';
import Faq from '../components/Faq.astro';
import BookForm from '../components/BookForm.astro';
import { sanity } from '../lib/sanity.js';
import { HOME_QUERY } from '../lib/queries.js';

const data = await sanity.fetch(HOME_QUERY);
const { settings = {}, page = {} } = data || {};
---
<Base settings={settings} page={page}>
  <main id="main">
    <Hero page={page} settings={settings} />
    <Intro page={page} settings={settings} />
    <Services page={page} />
    <Included page={page} />
    <Addons page={page} />
    <Club page={page} />
    <HowItWorks page={page} />
    <WhyUs page={page} />
    <SnapSend page={page} settings={settings} />
    <Gallery page={page} />
    <Reviews page={page} settings={settings} />
    <Areas page={page} settings={settings} />
    <Faq page={page} />
  </main>
  <BookForm slot="book" page={page} settings={settings} />
</Base>
