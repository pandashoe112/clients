---
import Tick from './Tick.astro';

const { page = {}, settings = {}, packages = [] } = Astro.props;

// The card style also decides the button style, the way the original page had it.
const btn = { standard: 'btn btn-dark', feature: 'btn btn-white', deep: 'btn btn-grey' };
const sms = `sms:${settings.phoneHref || ''}`;
---
<section class="pricing" id="packages">
  <div class="wrap">
    <div class="pricing-head">
      <div>
        <span class="sec-lead"><i></i><span>{page.packagesEyebrow}</span></span>
        <h2 class="sec-title">{page.packagesHeading}</h2>
      </div>
      <p class="sec-sub">{page.packagesIntro}</p>
    </div>
    <div class="price-row" id="ceramic">
      {packages.map((p) => (
        <div class={p.variant && p.variant !== 'standard' ? `pcard ${p.variant}` : 'pcard'}>
          <h3>{p.title}</h3>
          <span class="sub">{p.subtitle}</span>
          <div class="amt">{p.priceFrom}</div>
          <p class="from">{p.priceNote}</p>
          {(p.vehiclePrices || []).length > 0 && (
            <div class="veh-list">
              {p.vehiclePrices.map((v) => <div><small>{v.label}</small><b>{v.price}</b></div>)}
            </div>
          )}
          <ul class="ticks">
            {(p.features || []).map((f) => <li><Tick />{f}</li>)}
          </ul>
          <a class={btn[p.variant] || btn.standard} href="#book">{p.ctaLabel} <span class="chev">→</span></a>
        </div>
      ))}
    </div>
    <div class="helper">
      <div>
        <b>{page.helperHeading}</b>
        <p>{page.helperText}</p>
      </div>
      <a class="btn btn-dark" href={sms}>{page.helperCtaLabel} <span class="chev">→</span></a>
    </div>
  </div>
</section>
