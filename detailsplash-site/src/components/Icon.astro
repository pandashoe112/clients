---
// The icon sets lifted straight out of the original page.
//   family="svc"     two-tone icons in the services grid, coloured via .base/.accent/.solid
//   family="addon"   plain stroke icons on the add-on cards
//   family="feature" plain stroke icons in the intro feature list
const { name, family = 'svc' } = Astro.props;
---
{family === 'svc' && (
  <svg class="ic" viewBox="0 0 24 24" fill="none" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'car' && (<>
      <path class="base" d="M3.5 14h17M6 14l1.5-5.4A2 2 0 0 1 9.4 7h5.2a2 2 0 0 1 1.9 1.6L18 14M6.5 14v3M17.5 14v3"/>
      <path class="accent" d="M9.5 10.6h5"/>
      <circle class="solid" cx="8" cy="17.2" r="1.5"/>
      <circle class="solid" cx="16" cy="17.2" r="1.5"/>
    </>)}
    {name === 'droplet' && (<>
      <path class="base" d="M12 3.2S5.6 10.6 5.6 14.8A6.4 6.4 0 0 0 18.4 14.8C18.4 10.6 12 3.2 12 3.2z"/>
      <path class="accent" d="M9.4 15a2.6 2.6 0 0 0 2.6 2.6"/>
      <circle class="solid" cx="15.2" cy="11.6" r="1.15"/>
    </>)}
    {name === 'ceramic' && (<>
      <path class="base" d="M12 3.4 13.9 9l5.6 1.9-5.6 1.9L12 18.4l-1.9-5.6L4.5 10.9 10.1 9z"/>
      <path class="solid" d="M18.6 3l.66 1.94L21.2 5.6l-1.94.66L18.6 8.2l-.66-1.94L16 5.6l1.94-.66z"/>
      <path class="accent" d="M5.9 16.8l.5 1.3 1.3.5-1.3.5-.5 1.3-.5-1.3-1.3-.5 1.3-.5z"/>
    </>)}
    {name === 'polish' && (<>
      <path class="base" d="M3.4 16.8 9.6 10.6l3 3 7.6-7.6M3.4 20.6h17.2"/>
      <path class="accent" d="M14.6 6h5.6v5.6"/>
      <circle class="solid" cx="9.6" cy="10.6" r="1.45"/>
    </>)}
    {name === 'headlight' && (<>
      <path class="base" d="M8.6 13.6a3.4 3.4 0 1 1 6.8 0c0 1.6-.9 2.3-1.2 3.1a1.5 1.5 0 0 1-1.4 1h-1.6a1.5 1.5 0 0 1-1.4-1c-.3-.8-1.2-1.5-1.2-3.1zM10.7 20.3h2.6"/>
      <path class="accent" d="M4.2 12.4h1.9M17.9 12.4h1.9M6.7 7l1.3 1.3M16 8.3 17.3 7M12 4.1v1.9"/>
    </>)}
    {name === 'glass' && (<>
      <rect class="base" x="3.4" y="5.2" width="17.2" height="12" rx="2.2"/>
      <path class="accent" d="M7 8.8c1.3 1.1 1.3 2.5 0 3.6M11 8.8c1.3 1.1 1.3 2.5 0 3.6"/>
      <circle class="solid" cx="16.4" cy="10.7" r="1.3"/>
    </>)}
  </svg>
)}

{family === 'addon' && (
  <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
    {name === 'headlight' && (<>
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1"/>
    </>)}
    {name === 'sparkle' && (<path d="M12 3l2.4 6.2L21 12l-6.6 2.8L12 21l-2.4-6.2L3 12l6.6-2.8z"/>)}
    {name === 'polish' && (<>
      <path d="M3 17l6-6 4 4 8-8"/>
      <path d="M14 7h7v7"/>
    </>)}
    {name === 'droplet' && (<path d="M12 3C12 3 5 11 5 16a7 7 0 0 0 14 0c0-5-7-13-7-13z"/>)}
  </svg>
)}

{family === 'feature' && (
  <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {name === 'van' && (<>
      <path d="M14 7h4l3 4v5h-2M3 16V7a1 1 0 0 1 1-1h10v10M3 16h2m9 0h-4"/>
      <circle cx="7.5" cy="17.5" r="1.9"/>
      <circle cx="16.5" cy="17.5" r="1.9"/>
    </>)}
    {name === 'list' && (<>
      <rect x="3" y="3" width="18" height="18" rx="3"/>
      <path d="M7 15h10M7 11h10M7 7h6"/>
    </>)}
    {name === 'shield' && (<>
      <path d="M12 2 4 6v6c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V6l-8-4z"/>
      <path d="m9 12 2 2 4-4"/>
    </>)}
    {name === 'sparkle' && (<path d="M12 3l2.4 6.2L21 12l-6.6 2.8L12 21l-2.4-6.2L3 12l6.6-2.8z"/>)}
  </svg>
)}
