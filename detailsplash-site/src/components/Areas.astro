---
import { bg } from '../lib/sanity.js';

const { page = {}, settings = {}, areas = [] } = Astro.props;
const tel = settings.phoneHref || '';
---
<section class="areas" id="areas">
  <div class="areas-map" aria-hidden="true" style={bg(page.areasImage, 1500)}></div>
  <div class="areas-veil" aria-hidden="true"></div>
  <div class="wrap">
    <div class="areas-head">
      <h2>{page.areasHeading}</h2>
      <p>{page.areasText}</p>
    </div>
    <div class="areas-grid">
      {areas.map((a) => (
        <div class="area">
          <h3><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg> {a.title}</h3>
          <ul>{(a.suburbs || []).map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </div>
    <p class="areas-note">{page.areasNote} <a href={`tel:${tel}`}>Call or text {settings.phone}</a> and we'll tell you straight&nbsp;away.</p>
  </div>
</section>
