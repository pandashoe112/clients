---
import '../styles/global.css';
import GoogleMark from '../components/GoogleMark.astro';
import { img } from '../lib/sanity.js';

const { settings = {}, page = {}, faqs = [], packages = [] } = Astro.props;

const site = settings.siteUrl || Astro.site?.href?.replace(/\/$/, '') || '';
const canonical = site ? site + '/' : '';
const logoUrl = img(settings.logo, 700);
const tel = settings.phoneHref || '';
const rating = settings.ratingValue;
const reviewCount = settings.reviewCount;

// Structured data is generated from the same content the page renders, so the
// two cannot drift apart the way a hand-maintained block does.
const business = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'AutoWash'],
  '@id': site + '/#business',
  name: settings.businessName,
  description: page.seoDescription,
  url: canonical,
  telephone: tel ? '+61' + tel.replace(/^0/, '') : undefined,
  email: settings.email,
  priceRange: '$$',
  logo: logoUrl || undefined,
  image: img(page.whyImage, 1200) || undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Melbourne',
    addressRegion: 'VIC',
    addressCountry: 'AU'
  },
  areaServed: [{ '@type': 'City', name: 'Melbourne' }],
  serviceArea: {
    '@type': 'GeoCircle',
    geoMidpoint: { '@type': 'GeoCoordinates', latitude: -37.8136, longitude: 144.9631 },
    geoRadius: '40000'
  },
  aggregateRating: rating && reviewCount
    ? { '@type': 'AggregateRating', ratingValue: String(rating), reviewCount: String(reviewCount) }
    : undefined,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Mobile car detailing services',
    itemListElement: packages.map((p) => ({
      '@type': 'Offer',
      name: p.title,
      priceCurrency: 'AUD',
      price: (p.priceFrom || '').replace(/[^0-9.]/g, ''),
      itemOffered: {
        '@type': 'Service',
        name: p.title + (p.subtitle ? ' — ' + p.subtitle : ''),
        description: (p.features || []).join('. ')
      }
    }))
  }
};

// JSON.stringify leaves "<" alone, so a "</script>" typed into any CMS field
// would close this tag early and the rest would be parsed as live HTML.
// Escaping it keeps the JSON valid and the tag closed.
const ld = (obj) => JSON.stringify(obj).replace(/</g, '\\u003c');

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer }
  }))
};
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{page.seoTitle}</title>
<meta name="description" content={page.seoDescription}>
{canonical && <link rel="canonical" href={canonical}>}
<meta name="robots" content="index,follow,max-image-preview:large">
<meta name="geo.region" content="AU-VIC">
<meta name="geo.placename" content="Melbourne">
<meta property="og:type" content="website">
<meta property="og:site_name" content={settings.businessName}>
<meta property="og:title" content={page.ogTitle || page.seoTitle}>
<meta property="og:description" content={page.ogDescription || page.seoDescription}>
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:locale" content="en_AU">
<meta name="twitter:card" content="summary_large_image">
{logoUrl && <link rel="icon" href={logoUrl}>}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body id="top">
<a class="skip" href="#main">Skip to content</a>

<div class="announce">
  <div class="wrap">
    <span class="rate">
      <GoogleMark />
      {rating} <span class="stars">★★★★★</span> ({reviewCount} reviews)
    </span>
    <span class="msg">{settings.announcementText}</span>
  </div>
</div>

<header class="nav">
  <div class="wrap navbar">
    <a class="logo-mark" href="#top" aria-label={`${settings.businessName} home`}>
      {logoUrl && <img src={logoUrl} alt={settings.businessName} width="700" height="245">}
    </a>
    <ul class="navlinks">
      <li>
        <button type="button" aria-expanded="false">Services
          <svg class="caret" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul class="submenu">
          <li><a href="#services">All services<small>Everything we offer, at a&nbsp;glance</small></a></li>
          <li><a href="#packages">Detailing packages<small>Freshen Up and Deep Clean</small></a></li>
          <li><a href="#ceramic">Ceramic coatings<small>Gtechniq 5 year protection</small></a></li>
          <li><a href="#addons">Add-on services<small>Paint, headlights and glass</small></a></li>
          <li><a href="#club">Monthly Club<small>Regular cleans, discounted</small></a></li>
        </ul>
      </li>
      <li>
        <button type="button" aria-expanded="false">Our work
          <svg class="caret" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <ul class="submenu">
          <li><a href="#gallery">Gallery<small>Recent cars we've detailed</small></a></li>
          <li><a href="#reviews">Reviews<small>{rating} from {reviewCount} Google reviews</small></a></li>
        </ul>
      </li>
      <li><a href="#areas">Service areas</a></li>
      <li><a href="#how">How it works</a></li>
      <li><a href="#faq">FAQs</a></li>
    </ul>
    <div class="nav-right">
      <a class="nav-call" href={`tel:${tel}`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.6 1.9z"/></svg>
        <span><small>Call {settings.contactName}</small><b>{settings.phone}</b></span>
      </a>
      <a class="btn btn-blue" href="#book">Book a detail</a>
      <button class="burger" type="button" aria-label="Open menu" aria-expanded="false">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobnav" id="mobnav" aria-label="Mobile">
  <h4>Services</h4>
  <ul>
    <li><a href="#services">All services</a></li>
    <li><a href="#packages">Detailing packages</a></li>
    <li><a href="#ceramic">Ceramic coatings</a></li>
    <li><a href="#addons">Add-on services</a></li>
    <li><a href="#club">Monthly Club</a></li>
  </ul>
  <h4>Our work</h4>
  <ul>
    <li><a href="#gallery">Gallery</a></li>
    <li><a href="#reviews">Reviews</a></li>
  </ul>
  <h4>More</h4>
  <ul>
    <li><a href="#areas">Service areas</a></li>
    <li><a href="#how">How it works</a></li>
    <li><a href="#faq">FAQs</a></li>
  </ul>
  <div class="actions">
    <a class="btn btn-blue" href="#book">Book a detail</a>
    <a class="btn btn-grey" href={`tel:${tel}`}>Call {settings.phone}</a>
  </div>
</nav>

<slot />

<footer>
  <slot name="book" />
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-about">
        <a href="#top">{logoUrl && <img src={logoUrl} alt={settings.businessName} width="700" height="245">}</a>
        <p>{settings.footerBlurb}</p>
        <div class="foot-rating"><span class="stars">★★★★★</span> {rating} from {reviewCount} Google reviews</div>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="#packages">Freshen Up detail</a></li>
          <li><a href="#packages">The Deep Clean detail</a></li>
          <li><a href="#ceramic">Ceramic coatings</a></li>
          <li><a href="#addons">Paint correction</a></li>
          <li><a href="#addons">Headlight restoration</a></li>
          <li><a href="#club">Monthly Club</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="#services">All services</a></li>
          <li><a href="#how">How it works</a></li>
          <li><a href="#gallery">Our work</a></li>
          <li><a href="#reviews">Reviews</a></li>
          <li><a href="#areas">Service areas</a></li>
          <li><a href="#faq">FAQs</a></li>
        </ul>
      </div>
      <div>
        <h4>Get in touch</h4>
        <ul class="foot-contact">
          <li><a href={`tel:${tel}`}>{settings.phone}</a></li>
          <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
          <li><span>{settings.serviceAreaLabel}</span></li>
        </ul>
        <div class="foot-cta">
          <a class="btn btn-blue" href="#book">Book a detail</a>
          <a class="btn btn-grey" href={`tel:${tel}`}>Call</a>
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>{settings.copyrightLine}</span>
      <span>{settings.footerNote}</span>
    </div>
  </div>
</footer>

<script type="application/ld+json" set:html={ld(business)} />
<script type="application/ld+json" set:html={ld(faqLd)} />

<script>
  const burger = document.querySelector('.burger');
  const mob = document.getElementById('mobnav');
  burger?.addEventListener('click', () => {
    const open = mob.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.querySelectorAll('#mobnav a').forEach((a) => {
    a.addEventListener('click', () => {
      mob.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    });
  });
</script>
</body>
</html>
