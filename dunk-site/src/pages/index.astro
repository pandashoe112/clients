---
import Base from '../layouts/Base.astro';
import Nav from '../includes/nav.astro';
import Reviews from '../includes/reviews.astro';
import Cases from '../includes/cases.astro';
import WhyUs from '../includes/why-us.astro';
import StrategyCall from '../includes/strategy-call.astro';
---

<Base
  title="DUNK | Digital marketing agency for Australian businesses"
  description="Google Ads, Meta Ads, SEO and link building for Australian businesses. Senior marketers on every account, plain-language reporting, no lock-in contracts."
>

<header class="hero">
  <div class="hero__media" role="img" aria-label="Two marketers reviewing campaign plans and reports spread across a sunlit desk"></div>
  <div class="hero__scrim"></div>

  <!-- NAV -->
  <Nav />

  <!-- HERO -->
  <div class="hero__body">
    <div class="hero__copy">
      <p class="hero__rating">
        <span class="faces" aria-hidden="true"><span class="face"><img src="/img/face-1.jpg" alt=""></span><span class="face"><img src="/img/face-2.jpg" alt=""></span><span class="face"><img src="/img/face-3.jpg" alt=""></span><span class="face"><img src="/img/face-4.jpg" alt=""></span></span>
        <span>Rated 4.8 by our clients</span>
        <span class="stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
      </p>
      <h1>Marketing that gets you found, clicked and <span class="hl">chosen</span></h1>
      <p class="hero__lede">From Google Ads and Meta Ads to SEO and link building, we build growth strategies that drive real business results.</p>
      <div class="hero__actions">
        <a class="btn btn--lime" href="#contact">Book a Free Growth Call<span class="btn__arrow" aria-hidden="true">&#8599;</span></a>
        <a class="hero__call" href="tel:0396994585">or call 03 9699 4585</a>
      </div>
    </div>

    <div class="hero__media-card">
      <img src="/img/hero-card.jpg" alt="Two marketers reviewing campaign plans and reports spread across a sunlit desk">
    </div>
  </div>
</header>
<section class="approach">
  <p class="approach__statement">We&rsquo;re a Melbourne-based team of marketers who help Australian businesses grow through better Google Ads, Meta Ads, SEO and link building. We work closely with our clients, keep things straightforward, and focus on what actually matters to your business. <strong>More leads, more sales, more growth.</strong></p>

  <div class="marquee">
      <div class="marquee__track">
        <div class="marquee__set">
          <div class="logo"><img alt="Dometic" src="/img/dometic.webp"></div>
          <div class="logo"><img alt="Smile Pro" src="/img/smile-pro.webp"></div>
          <div class="logo"><img alt="The Mad Hueys" src="/img/the-mad-hueys.webp"></div>
          <div class="logo"><img alt="Bydee" src="/img/bydee.webp"></div>
          <div class="logo"><img alt="Frankly My Dear" src="/img/frankly-my-dear.webp"></div>
          <div class="logo"><img alt="Naked Harvest" src="/img/naked-harvest.webp"></div>
        </div>
        <div class="marquee__set" aria-hidden="true">
          <div class="logo"><img alt="Dometic" src="/img/dometic.webp"></div>
          <div class="logo"><img alt="Smile Pro" src="/img/smile-pro.webp"></div>
          <div class="logo"><img alt="The Mad Hueys" src="/img/the-mad-hueys.webp"></div>
          <div class="logo"><img alt="Bydee" src="/img/bydee.webp"></div>
          <div class="logo"><img alt="Frankly My Dear" src="/img/frankly-my-dear.webp"></div>
          <div class="logo"><img alt="Naked Harvest" src="/img/naked-harvest.webp"></div>
        </div>
      </div>
    </div>
</section>

<section class="picker" id="get-started">
  <div class="picker__head">
    <h2>What are your current digital marketing challenges?</h2>
    <p class="picker__lede">Pick the one that sounds like you. We'll tell you which channels actually fit, what it costs, and what to expect.</p>
  </div>

  <div class="picker__grid">
    <a class="pick pick--leads" href="https://calendly.com/dunk-agency/growth-call">
      <span class="pick__hover" aria-hidden="true"><span class="pick__hover-btn">Get a free Google Ads quote <span class="pick__hover-arrow">&#8594;</span></span></span>
      <span class="pick__bg" style="background-image:var(--photo-trade)" aria-hidden="true"></span>
      <span class="pick__num">01 <i>/</i> Leads</span>
      <div class="pick__panel">
        <p class="pick__title">I want to generate leads online for my business</p>
        <p class="pick__desc">Google Ads put you in front of the people searching for what you sell today.</p>
        <div class="pick__chips"><span>Search Ads</span><span>Shopping Ads</span><span>Performance Max</span></div>
      </div>
    </a>
    <a class="pick pick--aware" href="https://calendly.com/dunk-agency/growth-call">
      <span class="pick__hover" aria-hidden="true"><span class="pick__hover-btn">Get a free Meta Ads quote <span class="pick__hover-arrow">&#8594;</span></span></span>
      <span class="pick__bg" style="background-image:var(--photo-desk)" aria-hidden="true"></span>
      <span class="pick__num">02 <i>/</i> Awareness</span>
      <div class="pick__panel">
        <p class="pick__title">I want to run creative advertising on Meta</p>
        <p class="pick__desc">Meta Ads and digital PR reach your market before it starts looking.</p>
        <div class="pick__chips"><span>Facebook Ads</span><span>Instagram Ads</span><span>Retargeting</span></div>
      </div>
    </a>
    <a class="pick pick--organic" href="https://calendly.com/dunk-agency/growth-call">
      <span class="pick__hover" aria-hidden="true"><span class="pick__hover-btn">Get a free SEO quote <span class="pick__hover-arrow">&#8594;</span></span></span>
      <span class="pick__bg" style="background-image:var(--photo-focus)" aria-hidden="true"></span>
      <span class="pick__num">03 <i>/</i> Organic</span>
      <div class="pick__panel">
        <p class="pick__title">I want to get traffic on Google through SEO</p>
        <p class="pick__desc">SEO and link building stack up month on month into visibility you own.</p>
        <div class="pick__chips"><span>SEO</span><span>Link Building</span><span>Digital PR</span></div>
      </div>
    </a>
  </div>
</section>

<StrategyCall />

<section class="svc" id="services-overview">
  <div class="svc__inner">
    <div class="svc__aside">
      <h2>What are our digital marketing services?</h2>
      <p class="svc__lede">Google Ads, Meta Ads, SEO and link building. That is the whole list.
        Most businesses only need two of them, and we would rather run two properly than four badly.</p>
      <a class="btn btn--ink" href="#contact">Talk to us about which two <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M13 6.5 18.5 12 13 17.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <div class="svc__thumbs">
      <button class="svc__thumb is-active" type="button" style="background-image:var(--photo-trade)" data-svc="0" aria-label="Google Advertising"></button>
      <button class="svc__thumb" type="button" style="background-image:var(--photo-desk)" data-svc="1" aria-label="Meta Advertising"></button>
      <button class="svc__thumb" type="button" style="background-image:var(--photo-focus)" data-svc="2" aria-label="Search Engine Optimisation"></button>
      <button class="svc__thumb" type="button" style="background-image:var(--photo-studio)" data-svc="3" aria-label="Link Building"></button>
      </div>
    </div>

    <div class="svc__rail" id="svc-rail">
    <a class="scard" href="/services/google-ads" style="--card-photo:var(--photo-trade)">
      <span class="scard__ph" aria-hidden="true"></span>
      <span class="scard__scrim" aria-hidden="true"></span>
      <span class="scard__go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M13 6.5 18.5 12 13 17.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="scard__chip">Paid search</span>
      <h3>Google Advertising</h3>
    </a>
    <a class="scard" href="/services/meta-ads" style="--card-photo:var(--photo-desk)">
      <span class="scard__ph" aria-hidden="true"></span>
      <span class="scard__scrim" aria-hidden="true"></span>
      <span class="scard__go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M13 6.5 18.5 12 13 17.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="scard__chip">Paid social</span>
      <h3>Meta Advertising</h3>
    </a>
    <a class="scard" href="/services/seo" style="--card-photo:var(--photo-focus)">
      <span class="scard__ph" aria-hidden="true"></span>
      <span class="scard__scrim" aria-hidden="true"></span>
      <span class="scard__go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M13 6.5 18.5 12 13 17.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="scard__chip">Organic search</span>
      <h3>Search Engine Optimisation</h3>
    </a>
    <a class="scard" href="/services/link-building" style="--card-photo:var(--photo-studio)">
      <span class="scard__ph" aria-hidden="true"></span>
      <span class="scard__scrim" aria-hidden="true"></span>
      <span class="scard__go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4.5 12h14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/><path d="M13 6.5 18.5 12 13 17.5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      <span class="scard__chip">Authority</span>
      <h3>Link Building</h3>
    </a>
    </div>
  </div>
</section>

<Reviews />

<Cases />

<WhyUs />

<section class="faq" id="faq">
  <div class="faq__inner">
    <div class="faq__side">
      <h2>Questions people ask before they sign up</h2>
      <p>If yours is not here, ask it on the call. We would rather answer it before you commit
        to anything than after.</p>
      <a class="btn btn--lime" href="#contact">Book a Free Growth Call<span class="btn__arrow" aria-hidden="true">&#8599;</span></a>
      <a class="faq__tel" href="tel:0396994585">or call 03 9699 4585</a>
    </div>

    <div class="faq__list">
      <details class="qa" name="faq" open>
        <summary>What does it cost?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>Google Ads management starts at $139 a week and Meta at $150 a week, both billed monthly. SEO is quoted on the work involved. Ad spend is separate and goes straight to Google or Meta, never through us.</p></div>
      </details>
      <details class="qa" name="faq">
        <summary>What if I do not need everything you offer?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>Then we will tell you. Plenty of businesses only need one channel done properly, and we would rather run that well than sell you three. If we are not the right fit at all, we will say so on the call.</p></div>
      </details>

      <details class="qa" name="faq">
        <summary>Am I locked into a contract?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>No. Month to month, cancel with notice. If the work is any good you will not want to leave, and if it is not, a contract should not be the thing keeping you here.</p></div>
      </details>
      <details class="qa" name="faq">
        <summary>Who actually works on my account?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>Senior specialists who build and run campaigns every day, not an account manager relaying messages to a junior. You will know their names.</p></div>
      </details>
      <details class="qa" name="faq">
        <summary>How long before I see anything?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>Google and Meta Ads can be live inside a fortnight and you will see leads come through as soon as spend starts. SEO is a longer play, usually three to six months before it moves in a way you would notice.</p></div>
      </details>
      <details class="qa" name="faq">
        <summary>Do I own my accounts and data?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>Yes. Ad accounts, analytics and any assets we build sit in your name. If you ever walk, they stay with you and nothing needs migrating.</p></div>
      </details>
      <details class="qa" name="faq">
        <summary>Do you only work with Melbourne businesses?<span class="qa__icon" aria-hidden="true"></span></summary>
        <div class="qa__body"><p>We are based in South Melbourne and work with businesses right across Australia. Plenty of clients we have never met in person.</p></div>
      </details>
    </div>
  </div>
</section>

</Base>
