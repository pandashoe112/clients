---
/* The header, shared by every page.
   variant "over" sits it on a hero photograph, the way the homepage does.
   variant "light" is the white bar the SEO page uses.
   current is a service href, and marks that item in the What We Do panel. */
interface Props { variant?: "over" | "light"; current?: string }
const { variant = "over", current = "" } = Astro.props;
const light = variant === "light";
const cls = light ? "nav nav--light" : "nav";
---
<nav class={cls} aria-label="Main">
  <a class="nav__logo" href="/" aria-label="DUNK home"><svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 443.12 158.68"><defs><style>.cls-1{fill:currentColor;}</style></defs><g ><g><path class="cls-1" d="M438.05,137.29l-13.27-55.95h-12.08c-4.19,0-5.98-3.39-5.98-7.17h17.86l13.47-69.59,.44-2.29,.44-2.29h-49.44l-.32,2.29-9.84,69.67h-2.99V0h-47.44V158.68h47.44V82.33h2.99l14.35,76.34h49.44l-5.07-21.39Z"/><path class="cls-1" d="M71.77,0H0V158.68H71.77c16.14,0,29.5-13.36,29.5-29.5V29.51c0-16.15-13.36-29.51-29.5-29.51Zm-17.55,119.61c0,3.78-3.59,5.78-6.97,5.78V29.51c3.38,0,6.97,1.99,6.97,5.97V119.61Z"/><path class="cls-1" d="M163.32,114.42c0,4.59-3.39,5.98-7.18,5.98V0h-46.84V128.98c0,17.94,17.55,29.7,34.89,29.7h37.84c15.65,0,28.33-12.68,28.33-28.33V0h-47.04V114.42Z"/><polygon class="cls-1" points="275.98 68.98 272.99 68.98 263.25 0 218.39 0 218.39 158.68 262.52 158.68 262.52 89.82 265.51 89.82 275.24 158.68 320.86 158.68 320.86 0 275.98 0 275.98 68.98"/></g></g></svg><span class="nav__star" aria-hidden="true"><svg viewBox="0 0 100 100" fill="currentColor"><path d="M44 0h12v30l21-21 8.5 8.5-21 21H100v12H64.5l21 21L77 80l-21-21v41H44V59l-21 21-8.5-8.5 21-21H0V38h35.5l-21-21L23 8.5l21 21V0Z"/></svg></span></a>

  <div class="nav__menu">
    <div class="nav__item" data-dropdown>
      <button class="nav__link" aria-expanded="false" aria-haspopup="true">
        What We Do
        <svg viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="drop">
        <a class={"drop__link" + (current === "/services/seo" ? " is-current" : "")} href="/services/seo">
          <div class="drop__title"><span>Search Engine Optimisation</span><span>&#8594;</span></div>
          <div class="drop__desc">Build the demand you'll capture next year</div>
        </a>
        <a class={"drop__link" + (current === "/services/google-ads" ? " is-current" : "")} href="/services/google-ads">
          <div class="drop__title"><span>Google Advertising</span><span>&#8594;</span></div>
          <div class="drop__desc">Capture the demand that exists today</div>
        </a>
        <a class={"drop__link" + (current === "/services/meta-ads" ? " is-current" : "")} href="/services/meta-ads">
          <div class="drop__title"><span>Meta Advertising</span><span>&#8594;</span></div>
          <div class="drop__desc">Create demand before anyone searches</div>
        </a>
        <a class="drop__foot" href="https://calendly.com/dunk-agency/growth-call">Not sure which you need? Let us work it out <span>&#8594;</span></a>
      </div>
    </div>

    <div class="nav__item" data-dropdown>
      <button class="nav__link" aria-expanded="false" aria-haspopup="true">
        Who We Work With
        <svg viewBox="0 0 12 8" fill="none" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <div class="drop">
        <a class="drop__link" href="#who-we-work-with">
          <div class="drop__title"><span>Small business owners</span><span>&#8594;</span></div>
          <div class="drop__desc">Running the marketing between jobs</div>
        </a>
        <a class="drop__link" href="#who-we-work-with">
          <div class="drop__title"><span>eCommerce brands</span><span>&#8594;</span></div>
          <div class="drop__desc">Revenue per session is the number that counts</div>
        </a>
        <a class="drop__link" href="#who-we-work-with">
          <div class="drop__title"><span>Trade and service businesses</span><span>&#8594;</span></div>
          <div class="drop__desc">You need the phone ringing locally</div>
        </a>
        <a class="drop__foot" href="#who-we-work-with">See if we're a fit for your business <span>&#8594;</span></a>
      </div>
    </div>

    <a class="nav__link" href="#about">Who We Are</a>
  </div>

  <div class="nav__right">
    <a class="callus" href="tel:0396994585">
      <span class="callus__label">Call us, available now</span>
      <span class="callus__number">03 9699 4585 <span class="callus__dot" aria-hidden="true"></span></span>
    </a>
    <a class={light ? "btn btn--ink" : "btn btn--white"} href="#contact">Book a free quote</a>
    <button class="burger" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu"><span></span></button>
  </div>
</nav>
