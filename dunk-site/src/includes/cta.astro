<section class="cta" id="contact">
  <div class="cta__panel">
    <div class="cta__copy">
    <h2>Let's work out what your marketing should actually be doing</h2>
      <p class="cta__lede">A free half hour on the phone. We will look at what you are running now, tell you what we would change, and you can take that away whether you work with us or not.</p>
    </div>
      <form class="lead" onsubmit="return false">
        <div class="lead__grid">
          <p class="lead__field">
            <label for="lead-name">Full name <i aria-hidden="true">*</i></label>
            <input id="lead-name" name="name" type="text" autocomplete="name" placeholder="Jane Chen" required>
          </p>
          <p class="lead__field">
            <label for="lead-email">Email address <i aria-hidden="true">*</i></label>
            <input id="lead-email" name="email" type="email" autocomplete="email" placeholder="jane@yourbusiness.com.au" required>
          </p>
          <p class="lead__field">
            <label for="lead-phone">Phone <i aria-hidden="true">*</i></label>
            <input id="lead-phone" name="phone" type="tel" autocomplete="tel" placeholder="0400 000 000" required>
          </p>
          <p class="lead__field">
            <label for="lead-company">Company name <i aria-hidden="true">*</i></label>
            <input id="lead-company" name="company" type="text" autocomplete="organization" placeholder="Your business" required>
          </p>
          <p class="lead__field lead__field--wide">
            <label for="lead-site">Website</label>
            <input id="lead-site" name="website" type="url" autocomplete="url" placeholder="https://yourbusiness.com.au">
          </p>
          <p class="lead__field lead__select">
            <label for="lead-rev">Average monthly revenue <i aria-hidden="true">*</i></label>
            <select id="lead-rev" name="revenue" required>
              <option value="" selected>Select a range</option>
              <option>Under $50k</option><option>$50k to $100k</option><option>$100k to $250k</option><option>$250k to $500k</option><option>$500k or more</option>
            </select>
          </p>
          <p class="lead__field lead__select">
            <label for="lead-spend">Monthly marketing spend <i aria-hidden="true">*</i></label>
            <select id="lead-spend" name="spend" required>
              <option value="" selected>Select a range</option>
              <option>Under $2k</option><option>$2k to $5k</option><option>$5k to $10k</option><option>$10k to $25k</option><option>$25k or more</option>
            </select>
          </p>
          <p class="lead__field lead__field--wide">
            <label for="lead-help">How can we help? <i aria-hidden="true">*</i></label>
            <textarea id="lead-help" name="message" placeholder="What you are running now, and what you want more of." required></textarea>
          </p>
        </div>

        <button class="btn btn--lime lead__submit" type="submit">Book a free growth call</button>
        <p class="lead__note">Fields marked <b>*</b> are required. Please do not send card numbers, passwords or any other sensitive details through this form.</p>
      </form>
  </div>
</section>
