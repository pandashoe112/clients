---
interface Props {
  name: 'tick' | 'arrow' | 'phone' | 'google'
  class?: string
}

const {name, class: className} = Astro.props
---

{
  name === 'tick' && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M4 12.5l5.5 5.5L20 6.5" />
    </svg>
  )
}

{
  name === 'arrow' && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h13M13 6l6 6-6 6" />
    </svg>
  )
}

{
  name === 'phone' && (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.2.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z" />
    </svg>
  )
}

{
  name === 'google' && (
    <svg class={className} viewBox="0 0 24 24" aria-hidden="true">
      <path fill="#4285F4" d="M22.5 12.2c0-.8-.1-1.4-.2-2H12v3.9h6a5 5 0 0 1-2.2 3.3v2.7h3.6c2-2 3.1-4.9 3.1-7.9z" />
      <path fill="#34A853" d="M12 23c2.9 0 5.3-1 7.1-2.6l-3.6-2.7c-1 .7-2.2 1-3.5 1-2.7 0-5-1.8-5.9-4.2H2.4v2.8A10.7 10.7 0 0 0 12 23z" />
      <path fill="#FBBC05" d="M6.1 14.5a6.4 6.4 0 0 1 0-4.1V7.6H2.4a10.7 10.7 0 0 0 0 9.7l3.7-2.8z" />
      <path fill="#EA4335" d="M12 5.4c1.5 0 2.9.5 4 1.5l3-3A10.6 10.6 0 0 0 12 1 10.7 10.7 0 0 0 2.4 7.6l3.7 2.8C7 8 9.3 5.4 12 5.4z" />
    </svg>
  )
}
