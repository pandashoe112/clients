---
import type {QuoteForm} from '../lib/types'

interface Props {
  form: QuoteForm
  /** Business name, used to build the notification email subject. */
  businessName: string
  /**
   * Both forms post into the same Netlify inbox under the name "quote"; this value
   * rides along in a hidden field so you can still tell which one converted.
   */
  location: 'hero' | 'footer'
  /** Only the hero form owns the #quote anchor that every CTA scrolls to. */
  id?: string
  class?: string
}

const {form, businessName, location, id, class: className} = Astro.props
const uid = `${location}`

// Netlify's own UI has a subject setting, and a `subject` field in the page always
// beats it. So when nobody has set one in Sanity, send no field at all and let the
// Netlify setting apply — rather than silently overriding it with a generated line.
const subject = form.emailSubject?.trim() || null

// Netlify labels every value in the notification email with the input's `name`,
// so these are written the way they should read in an inbox, not as code.
// Values are filled in by AttributionFields.astro, with a plain-English fallback
// rather than a blank line.
const TRACKING = [
  {name: 'Google Click Id', key: 'gclid'},
  {name: 'Traffic Source', key: 'utm_source'},
  {name: 'Campaign', key: 'utm_campaign'},
  {name: 'Ad Group', key: 'utm_term'},
  {name: 'Landing Page', key: 'page_url'},
  {name: 'Came From', key: 'referrer'},
  {name: 'Device', key: 'device'},
  {name: 'Submitted', key: 'submitted'},
]

const AUTOCOMPLETE: Record<string, string | undefined> = {
  tel: 'tel',
  email: 'email',
  text: undefined,
}
---

<div class={className} id={id}>
  <h3>{form.heading}</h3>
  {form.subcopy && <p class="fsub">{form.subcopy}</p>}

  <form
    name="quote"
    method="POST"
    action="/thank-you/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
    data-quote-form
    data-subject-template={subject ?? undefined}
  >
    <input type="hidden" name="form-name" value="quote" />
    <input type="hidden" name="Form Position" value={location === 'hero' ? 'Hero form' : 'Footer form'} />

    {/* Sets the notification email subject and drops Netlify's [Netlify] prefix.
        Set here rather than in the Netlify UI so it is version controlled and a
        new site inherits it. */}
    {/* Must be lowercase `subject` — that exact name is what Netlify looks for to
        override the subject line, and it takes precedence over the Netlify UI
        setting. Netlify capitalises it to "Subject:" in the email body itself. */}
    {subject && <input type="hidden" name="subject" data-remove-prefix value={subject} data-subject />}

    <p class="hp">
      <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    {TRACKING.map((item) => <input type="hidden" name={item.name} data-track={item.key} />)}

    {
      form.fields.map((field) => {
        const id = `${field.name.replace(/\s+/g, '-').toLowerCase()}-${uid}`
        return (
          <>
            <label for={id}>{field.label}</label>

            {field.type === 'select' ? (
              <select id={id} name={field.name} required={field.required}>
                {(field.options ?? []).map((option) => (
                  <option>{option}</option>
                ))}
              </select>
            ) : field.type === 'textarea' ? (
              <textarea
                id={id}
                name={field.name}
                rows="4"
                required={field.required}
                placeholder={field.placeholder}
              />
            ) : (
              <input
                id={id}
                name={field.name}
                type={field.type}
                required={field.required}
                placeholder={field.placeholder}
                autocomplete={AUTOCOMPLETE[field.type]}
              />
            )}
          </>
        )
      })
    }

    <button class="btn btn-royal" type="submit">{form.submitLabel}</button>
  </form>

  <slot name="footnote">
    {form.footnote && <p class="fnote">{form.footnote}</p>}
  </slot>
</div>
