---
import type {QuoteForm} from '../lib/types'

interface Props {
  form: QuoteForm
  /**
   * Both forms post into the same Netlify inbox under the name "quote"; this value
   * rides along in a hidden field so you can still tell which one converted.
   */
  location: 'hero' | 'footer'
  /** Only the hero form owns the #quote anchor that every CTA scrolls to. */
  id?: string
  class?: string
}

const {form, location, id, class: className} = Astro.props
const uid = `${location}`
---

<div class={className} id={id}>
  <h3>{form.heading}</h3>
  {form.subcopy && <p class="fsub">{form.subcopy}</p>}

  <form
    name="quote"
    method="POST"
    action="/thank-you/"
    data-netlify="true"
    data-netlify-honeypot="bot-field"
  >
    <input type="hidden" name="form-name" value="quote" />
    <input type="hidden" name="form_location" value={location} />

    <p class="hp">
      <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
    </p>

    <input type="hidden" name="gclid" class="f-gclid" />
    <input type="hidden" name="utm_source" class="f-utm_source" />
    <input type="hidden" name="utm_medium" class="f-utm_medium" />
    <input type="hidden" name="utm_campaign" class="f-utm_campaign" />
    <input type="hidden" name="utm_term" class="f-utm_term" />
    <input type="hidden" name="page_url" class="f-page_url" />

    <label for={`n-${uid}`}>Your name</label>
    <input id={`n-${uid}`} name="name" type="text" required autocomplete="name" placeholder="First and last name" />

    <label for={`p-${uid}`}>Mobile</label>
    <input id={`p-${uid}`} name="mobile" type="tel" required autocomplete="tel" placeholder="04__ ___ ___" />

    <label for={`s-${uid}`}>Suburb</label>
    <input
      id={`s-${uid}`}
      name="suburb"
      type="text"
      required
      autocomplete="address-level2"
      placeholder="Where is the car parked?"
    />

    {
      form.serviceOptions && form.serviceOptions.length > 0 && (
        <>
          <label for={`w-${uid}`}>What do you need?</label>
          <select id={`w-${uid}`} name="service">
            {form.serviceOptions.map((option) => (
              <option>{option}</option>
            ))}
          </select>
        </>
      )
    }

    <button class="btn btn-royal" type="submit">{form.submitLabel}</button>
  </form>

  <slot name="footnote">
    {form.footnote && <p class="fnote">{form.footnote}</p>}
  </slot>
</div>
