# Copy to .env for local development. On Netlify these are set in netlify.toml
# under [build.environment], so there is nothing to configure in the UI.
#
# The dataset is public-read, so no API token is needed to build the site.
PUBLIC_SANITY_PROJECT_ID=me0j4kdl
PUBLIC_SANITY_DATASET=production
PUBLIC_SITE_ID=affordable-car-accessories
