---
import ServiceBase from '../layouts/ServiceBase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BatteryQuoteForm from '../components/BatteryQuoteForm.astro';
import Icon from '../components/Icon.astro';
import { sanity } from '../lib/sanity.js';

// A page rather than a section on /services/solar-battery/. The form asks
// twenty questions because that is what it takes to size a battery without a
// visit, and that does not belong bolted to the bottom of a service page - it
// needs the whole width and the visitor's full attention.
const { settings, services, areas, navBrands } = await sanity.fetch(`{
  "navBrands": *[_type == "brand"] | order(order asc, name asc){ _id, name, kind, hasPage, "slug": slug.current },
  "settings": *[_type == "siteSettings"][0]{
    businessName, phone, phoneHref, email, licence, established,
    ratingValue, reviewCount, instagramUrl, facebookUrl
  },
  "services": *[_type == "service"] | order(order asc){ _id, title, slug, summary, icon, hasPage },
  "areas": *[_type == "suburb" && hasPage == true && defined(slug.current)] | order(order asc, name asc){
    _id, name, postcode, "slug": slug.current
  }
}`);

const canonical = 'https://www.revelectrical.com.au/battery-quote/';

// What answering it gets them. The reason to fill in twenty questions has to
// be on the page, next to the questions.
const WHY = [
  {
    title: 'A real number, not a range',
    text: 'Enough detail to price the battery, the switchboard work and the cable run together, rather than quoting a band and revising it after a visit.'
  },
  {
    title: 'Often no site visit first',
    text: 'With photos of the board and the spot, we can usually quote from the desk and only come out to install.'
  },
  {
    title: 'Sized on your usage, not a guess',
    text: 'Your bill and your solar tell us what you actually use and when, which is what decides the capacity.'
  }
];
---
<ServiceBase
  title={`Battery Storage Quote | ${settings.businessName}`}
  description="Tell us about your home and we'll come back within 24 hours with an upfront price for solar battery storage. Only name, email and phone are required."
  canonical={canonical}
  settings={settings}
  crumbs={[{ name: 'Battery quote', url: canonical }]}
>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} contactHref="#quote" />

  <main id="main">
    <section class="section bg-cream">
      <div class="wrap bqpage">
        <div class="bqpage__intro reveal">
          <p class="eyebrow">Battery storage</p>
          <h1 class="h1" style="margin-top:12px;max-width:16ch">Get a price for battery storage</h1>
          <p class="lede" style="margin-top:20px;max-width:44ch">
            The more you can tell us, the closer the number. Only your name, email and phone are
            needed &mdash; skip anything you're not sure about and we'll work it out on site.
          </p>

          <ul class="bqwhy">
            {WHY.map((w) => (
              <li>
                <span class="bqwhy__tick"><Icon name="check" size={15} stroke={3} /></span>
                <div>
                  <h2 class="h4">{w.title}</h2>
                  <p>{w.text}</p>
                </div>
              </li>
            ))}
          </ul>

          <div class="bqpage__call">
            <p class="lede" style="font-size:.9375rem">Would rather talk it through?</p>
            <a class="btn btn-outline js-call" href={settings.phoneHref}>
              <Icon name="phone" size={16} stroke={2.2} /> Call {settings.phone}
            </a>
          </div>
        </div>

        <div class="bqpage__form reveal reveal-d1" id="quote">
          <BatteryQuoteForm settings={settings} />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter settings={settings} contactHref="#quote" />
</ServiceBase>
