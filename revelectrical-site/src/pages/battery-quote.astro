---
import ServiceBase from '../layouts/ServiceBase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BatteryQuoteSection from '../components/BatteryQuoteSection.astro';
import { sanity } from '../lib/sanity.js';

// A page rather than a section on /services/solar-battery/. The form asks
// twenty questions because that is what it takes to size a battery without a
// visit, and that does not belong bolted to the bottom of a service page - it
// needs the whole width and the visitor's full attention.
const { settings, services, areas, navBrands } = await sanity.fetch(`{
  "navBrands": *[_type == "brand"] | order(order asc, name asc){ _id, name, kind, hasPage, "slug": slug.current },
  "settings": *[_type == "siteSettings"][0]{
    businessName, phone, phoneHref, email, licence, established,
    ratingValue, reviewCount, instagramUrl, facebookUrl
  },
  "services": *[_type == "service"] | order(order asc){ _id, title, slug, summary, icon, hasPage },
  "areas": *[_type == "suburb" && hasPage == true && defined(slug.current)] | order(order asc, name asc){
    _id, name, postcode, "slug": slug.current
  }
}`);

const canonical = 'https://www.revelectrical.com.au/battery-quote/';

---
<ServiceBase
  title={`Battery Storage Quote | ${settings.businessName}`}
  description="Tell us about your home and we'll come back within 24 hours with an upfront price for solar battery storage. Only name, email and phone are required."
  canonical={canonical}
  settings={settings}
  crumbs={[{ name: 'Battery quote', url: canonical }]}
>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} contactHref="#quote" />

  <main id="main">
    <BatteryQuoteSection settings={settings} level={1} />
  </main>

  <SiteFooter settings={settings} contactHref="#quote" />
</ServiceBase>
