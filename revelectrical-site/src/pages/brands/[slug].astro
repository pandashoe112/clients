---
import ServiceBase from '../../layouts/ServiceBase.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ServiceHero from '../../components/ServiceHero.astro';
import CertifiedBand from '../../components/CertifiedBand.astro';
import ServiceSteps from '../../components/ServiceSteps.astro';
import DiffGrid from '../../components/DiffGrid.astro';
import BrandRange from '../../components/BrandRange.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import ServiceAreasBand from '../../components/ServiceAreasBand.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import FaqList from '../../components/FaqList.astro';
import FinalCta from '../../components/FinalCta.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { sanity } from '../../lib/sanity.js';
import { BRAND_QUERY, BRAND_PATHS_QUERY } from '../../lib/queries.js';
import '../../styles/brand.css';

export async function getStaticPaths() {
  const { sanity } = await import('../../lib/sanity.js');
  const { BRAND_PATHS_QUERY } = await import('../../lib/queries.js');
  const rows = await sanity.fetch(BRAND_PATHS_QUERY);
  return rows.map((r) => ({ params: { slug: r.slug } }));
}

const { slug } = Astro.params;
const { settings, brand, services, suburbs, areas, navBrands } = await sanity.fetch(BRAND_QUERY, { slug });

const canonical = `https://www.revelectrical.com.au/brands/${brand.slug}/`;
const title = brand.seoTitle || `${brand.name} | ${settings.businessName}`;
const description = brand.seoDescription || brand.summary;

// The brand page is a service page about one manufacturer, so it renders with
// the service sections rather than a second set that drifts out of step. This
// shapes the brand into what those sections expect. `slug` picks the install
// photos, which is why it carries a service slug rather than the brand's.
const asService = {
  title: brand.name,
  slug: brand.workSlug || 'ev-charging',
  heroHeading: brand.heroHeading,
  heroIntro: brand.heroIntro,
  heroTicks: brand.heroTicks,
  quoteHeading: brand.quoteHeading || `Get a price for your ${brand.name}`,
  quoteText: brand.quoteText,
  processEyebrow: brand.processEyebrow || 'How we do it',
  processHeading: brand.installHeading,
  processSteps: brand.installPoints,
  diffEyebrow: 'The range',
  diffHeading: brand.aboutHeading,
  diffIntro: (brand.aboutText || [])[0],
  diffItems: brand.aboutPoints,
  workEyebrow: 'Our work',
  workHeading: brand.workHeading || `${brand.name} installs we have done`,
  relatedHeading: brand.relatedHeading,
  relatedServices: brand.relatedServices,
  faqHeading: brand.faqHeading || `${brand.name} questions we get asked`,
  faqNote: brand.faqNote,
  faqs: brand.faqs,
  ctaEyebrow: brand.ctaEyebrow || 'Ready when you are',
  ctaHeading: brand.ctaHeading,
  ctaText: brand.ctaText
};
---
<ServiceBase
  title={title}
  description={description}
  canonical={canonical}
  settings={settings}
  faqs={brand.faqs || []}
>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} contactHref="#quote" />

  <main id="main">
    <ServiceHero
      service={asService}
      settings={settings}
      services={services}
      brandLogo={brand.logo}
    />
    <CertifiedBand brand={brand} settings={settings} />
    <ServiceSteps service={asService} />
    <BrandRange brand={brand} />
    <DiffGrid service={asService} />
    <WorkGrid service={asService} />
    <ServiceAreasBand service={asService} suburbs={suburbs} tone="bg-cream" />
    <RelatedServices service={asService} />
    <FaqList service={asService} settings={settings} />
    <FinalCta service={asService} settings={settings} />
  </main>

  <SiteFooter settings={settings} contactHref="#quote" />
</ServiceBase>
