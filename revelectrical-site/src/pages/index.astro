---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import PromptPanel from '../components/PromptPanel.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import WhyChoose from '../components/WhyChoose.astro';
import Gallery from '../components/Gallery.astro';
import BrandGrid from '../components/BrandGrid.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { sanity } from '../lib/sanity.js';
import { HOME_QUERY } from '../lib/queries.js';

const { settings, page, services, areas, suburbs, reviews, gallery, navBrands } = await sanity.fetch(HOME_QUERY);
---
<Base title={page.seoTitle} description={page.seoDescription} settings={settings}>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} />

  <main id="main">
    <Hero page={page} settings={settings} />
    <FeatureStrip items={page.featureItems} />
    <ServiceGrid
      heading={page.servicesHeading}
      intro={page.servicesIntro}
      services={services}
      note={page.servicesNote}
    />
    <PromptPanel page={page} settings={settings} />
    <ProcessSteps heading={page.processHeading} steps={page.processSteps} />
    <ServiceAreas
      heading={page.areasHeading}
      text={page.areasText}
      suburbs={suburbs}
      settings={settings}
    />
    <WhyChoose page={page} />
    <Gallery heading={page.galleryHeading} intro={page.galleryIntro} items={gallery} />
    <BrandGrid heading={page.brandsHeading} text={page.brandsText} brands={page.brands} />
    <Reviews settings={settings} reviews={reviews} />
    <ContactForm page={page} settings={settings} services={services} />
  </main>

  <SiteFooter settings={settings} />
</Base>
