---
import ServiceBase from '../layouts/ServiceBase.astro';
import Attribution from '../components/Attribution.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { sanity, img } from '../lib/sanity.js';
import { QUOTE_BUILDER_QUERY } from '../lib/queries.js';
import '../styles/quote.css';

const { settings, quote, items, services, areas, navBrands } = await sanity.fetch(QUOTE_BUILDER_QUERY);

// Nobody quotes a battery and downlights and a switchboard in one sitting, so
// the builder asks what the job is first and only shows that. Everything else
// comes back once, at the end, as extras worth doing while we are on site -
// which is also where the margin is.
const JOBS = [
  { key: 'ev', title: 'EV charging', blurb: 'A charger supplied and installed, or install only.',
    icon: '/icon-ev.webp', cats: ['ev'], lead: 'Which charger are you after?',
    sub: 'Supplied and installed, or install only if you have already bought one.' },
  { key: 'battery', title: 'Solar battery', blurb: 'Battery install, backup circuits and switchboard tie-in.',
    icon: '/icon-battery.webp', cats: ['battery'], lead: 'What do you need for the battery?',
    sub: 'The electrical side of a home battery, and keeping the essentials on when the grid drops.' },
  { key: 'switchboard', title: 'Switchboard and safety', blurb: 'Upgrades, safety switches and smoke alarms.',
    icon: '/icon-switchboard.webp', cats: ['switchboard'], lead: 'What needs doing?',
    sub: 'The compliance work most Melbourne homes are overdue for.' },
  { key: 'lighting', title: 'Lighting', blurb: 'Downlights, replacements and outdoor sensors.',
    icon: '/icon-lighting.webp', cats: ['lighting'], lead: 'What lighting are you after?',
    sub: 'Replacements, new points and outdoor sensor lights.' },
  { key: 'home', title: 'Around the home', blurb: 'Power points, fans, hot water and the rest.',
    icon: '/icon-induction.webp', cats: ['home'], lead: 'What can we sort out?',
    sub: 'The jobs worth booking while an electrician is coming anyway.' }
].map((j) => ({ ...j, items: items.filter((i) => j.cats.includes(i.category)) }))
 .filter((j) => j.items.length > 0);

// Extras are simply everything outside the chosen job, so adding a category in
// the Studio feeds both halves without anyone maintaining a second list.
const jobConfig = Object.fromEntries(JOBS.map((j) => [
  j.key,
  { title: j.title, lead: j.lead, sub: j.sub, cats: j.cats,
    extras: items.filter((i) => !j.cats.includes(i.category)).map((i) => i.category)
      .filter((c, k, a) => a.indexOf(c) === k) }
]));

const gst = quote?.gstRate ?? 10;
const validDays = quote?.validDays ?? 30;

const priceData = items.map((i) => ({
  id: i._id, name: i.name, price: i.price, unit: i.unit || '', allowQty: !!i.allowQty
}));

const stepMeta = [
  { key: 'job', title: 'Your job' },
  { key: 'main', title: 'Options' },
  { key: 'extras', title: 'Extras' },
  { key: 'details', title: 'Details' },
  { key: 'quote', title: 'Your quote' }
];
---
<ServiceBase
  title={`Build your own quote | ${settings.businessName}`}
  description="Pick what you need and get a written quote you can download, priced on our standard rates."
  canonical="https://www.revelectrical.com.au/quote-builder/"
  settings={settings}
  noindex={true}
>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} contactHref="#builder" />

  <main id="main">
    <section class="section bg-cream qbpage" id="builder">
      <div class="wrap">
        <div class="qbpage__head noprint">
          <div>
            <p class="eyebrow">Instant estimate</p>
            <h1 class="qbpage__title">{quote?.introHeading || 'Build your own quote'}</h1>
          </div>
          <p class="qbpage__sub">{quote?.introText}</p>
        </div>

        <div class="wiz" id="wiz">
          <nav class="wiz__rail noprint" aria-label="Quote steps">
            <ol class="wizrail">
              {stepMeta.map((s, i) => (
                <li class="wizrail__item" data-rail={s.key}>
                  <span class="wizrail__dot">{i + 1}</span>
                  <span class="wizrail__label" data-rail-label={s.key}>{s.title}</span>
                </li>
              ))}
            </ol>
            <div class="wizrail__foot">
              <p class="wizrail__note">Standard pricing, GST included. Nothing here commits you to anything.</p>
              <a class="wizrail__call js-call" href={settings.phoneHref}>
                <Icon name="phone" size={15} stroke={2.2} /> {settings.phone}
              </a>
            </div>
          </nav>

          <div class="wiz__stage">
            {/* ---------------- 1. pick the job ---------------- */}
            <section class="wizpane" data-pane="job">
              <header class="wizpane__head noprint">
                <span class="wizpane__icon wizpane__icon--glyph"><Icon name="tag" size={22} /></span>
                <div class="wizpane__headtext">
                  <h2 class="wizpane__title">What are you after a quote for?</h2>
                  <p class="wizpane__blurb">Pick one. You can add the smaller jobs at the end.</p>
                </div>
                <span class="wizpane__count">Step 1 of {stepMeta.length}</span>
              </header>
              <div class="wizpane__body">
                <ul class="jobgrid">
                  {JOBS.map((j) => (
                    <li>
                      <button class="jobcard" type="button" data-job={j.key}>
                        <span class="jobcard__icon"><img src={j.icon} alt="" width="30" height="30" /></span>
                        <span class="jobcard__name">{j.title}</span>
                        <span class="jobcard__blurb">{j.blurb}</span>
                        <span class="jobcard__go">Choose <Icon name="chevron" size={14} stroke={2.6} /></span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </section>

            {/* ---------------- 2 and 3. one list, filtered ---------------- */}
            <section class="wizpane" data-pane="picker" hidden>
              <header class="wizpane__head noprint">
                <span class="wizpane__icon"><img data-picker="icon" src="/icon-ev.webp" alt="" width="26" height="26" /></span>
                <div class="wizpane__headtext">
                  <h2 class="wizpane__title" data-picker="lead">Which charger are you after?</h2>
                  <p class="wizpane__blurb" data-picker="sub"></p>
                </div>
                <span class="wizpane__count" data-picker="count"></span>
              </header>
              <div class="wizpane__body">
                <ul class="qbitems">
                  {items.map((it) => (
                    <li class="qbitem__wrap" data-cat={it.category} hidden>
                      <label class="qbitem" for={`it-${it._id}`}>
                        <input class="qbitem__check" type="checkbox" id={`it-${it._id}`} data-item={it._id} />
                        <span class="qbitem__box" aria-hidden="true"><Icon name="check" size={14} stroke={3} /></span>
                        {it.image && (
                          <span class="qbitem__shot"><img src={img(it.image, 220)} alt="" loading="lazy" /></span>
                        )}
                        <span class="qbitem__body">
                          <span class="qbitem__name">
                            {it.name}
                            {it.popular && <span class="qbitem__pop">Popular</span>}
                          </span>
                          {it.blurb && <span class="qbitem__blurb">{it.blurb}</span>}
                          <span class="qbitem__price">
                            {it.priceNote && <span class="qbitem__from">{it.priceNote}</span>}
                            <span data-price-display={it._id}></span>
                            {it.unit && <span class="qbitem__unit">{it.unit}</span>}
                          </span>
                        </span>
                      </label>
                      {it.allowQty && (
                        <div class="qbqty" data-qty-for={it._id} hidden>
                          <button class="qbqty__btn" type="button" data-step="-1" aria-label="Fewer">−</button>
                          <input class="qbqty__input" type="number" min="1" max={it.maxQty || 20} value="1"
                                 data-qty-input={it._id} aria-label={`Quantity for ${it.name}`} />
                          <button class="qbqty__btn" type="button" data-step="1" aria-label="More">+</button>
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
                <p class="wizpane__skip" data-picker="skip">Nothing here for you? Skip straight past it.</p>
              </div>
            </section>

            {/* ---------------- 4. details ---------------- */}
            <section class="wizpane" data-pane="details" hidden>
              <header class="wizpane__head noprint">
                <span class="wizpane__icon wizpane__icon--glyph"><Icon name="document" size={22} /></span>
                <div class="wizpane__headtext">
                  <h2 class="wizpane__title">Who is this quote for?</h2>
                  <p class="wizpane__blurb">Your quote appears straight away and you can download it. We get a copy so we can confirm it.</p>
                </div>
                <span class="wizpane__count">Step {stepMeta.length - 1} of {stepMeta.length}</span>
              </header>
              <div class="wizpane__body">
                <form class="formgrid formgrid--two" id="qb-form" name="custom-quote" method="POST" action="/thank-you/"
                      data-netlify="true" netlify-honeypot="bot-field" novalidate>
                  <input type="hidden" name="form-name" value="custom-quote" />
                  <Attribution />
                  <input type="hidden" name="page_url" />
                  <input type="hidden" name="subject" value="🧾 Custom quote built on the site" />
                  <input type="hidden" name="quote_lines" id="qb-lines-field" />
                  <input type="hidden" name="quote_total" id="qb-total-field" />
                  <input type="hidden" name="quote_ref" id="qb-ref-field" />
                  <input type="hidden" name="quote_job" id="qb-job-field" />
                  {/* The same quote as JSON. The fields above are for reading;
                      this one is for whatever picks the email up and raises
                      the invoice. */}
                  <input type="hidden" name="quote_json" id="qb-json-field" />
                  <p class="hp"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

                  <div class="field">
                    <label class="label" for="q_name">Name</label>
                    <input class="input" type="text" id="q_name" name="name" autocomplete="name" placeholder="First and last name" required />
                  </div>
                  <div class="field">
                    <label class="label" for="q_email">Email</label>
                    <input class="input" type="email" id="q_email" name="email" autocomplete="email" placeholder="Email address" required />
                  </div>
                  <div class="field">
                    <label class="label" for="q_phone">Phone number</label>
                    <input class="input" type="tel" id="q_phone" name="phone" autocomplete="tel" placeholder="Phone number" required />
                  </div>
                  <div class="field">
                    <label class="label" for="q_address">Address</label>
                    <input class="input" type="text" id="q_address" name="address" autocomplete="street-address" placeholder="Street address and suburb" required />
                  </div>
                  <div class="field field--wide">
                    <label class="label" for="q_notes">Anything we should know? <span class="label__opt">(optional)</span></label>
                    <textarea class="input" id="q_notes" name="notes" placeholder="Access, timing, anything unusual"></textarea>
                  </div>
                </form>
              </div>
            </section>

            {/* ---------------- 5. the document ---------------- */}
            <section class="wizpane wizpane--doc" data-pane="quote" hidden>
              <header class="wizpane__head noprint">
                <span class="wizpane__icon wizpane__icon--glyph"><Icon name="checkCircle" size={22} /></span>
                <div class="wizpane__headtext">
                  <h2 class="wizpane__title">Your quote is ready</h2>
                  <p class="wizpane__blurb">A copy is on its way to us. Download it, or just close the tab — we have it.</p>
                </div>
              </header>
              <div class="wizpane__body wizpane__body--doc">
                <article class="qdoc" id="qb-doc">
                  <header class="qdoc__head">
                    <div>
                      <img class="qdoc__logo" src="/logo.webp" alt={settings.businessName} width="178" height="28" />
                      <p class="qdoc__biz">
                        Everything Electrification Pty Ltd t/a {settings.businessName}<br />
                        {settings.licence} · Licensed and insured<br />
                        {settings.phone} · {settings.email}
                      </p>
                    </div>
                    <div class="qdoc__meta">
                      <h3 class="qdoc__doctitle">Quotation</h3>
                      <dl>
                        <div><dt>Quote no.</dt><dd data-doc="ref">—</dd></div>
                        <div><dt>Date</dt><dd data-doc="date">—</dd></div>
                        <div><dt>Valid until</dt><dd data-doc="valid">—</dd></div>
                      </dl>
                    </div>
                  </header>

                  <section class="qdoc__to">
                    <h4>Prepared for</h4>
                    <p data-doc="customer">—</p>
                  </section>

                  <table class="qdoc__table">
                    <thead>
                      <tr>
                        <th scope="col">Description</th>
                        <th scope="col" class="num">Qty</th>
                        <th scope="col" class="num">Unit</th>
                        <th scope="col" class="num">Amount</th>
                      </tr>
                    </thead>
                    <tbody data-doc="lines"></tbody>
                    <tfoot>
                      <tr><th scope="row" colspan="3">Subtotal</th><td class="num" data-doc="sub">$0</td></tr>
                      <tr><th scope="row" colspan="3">GST ({gst}%)</th><td class="num" data-doc="gst">$0</td></tr>
                      <tr class="qdoc__grand"><th scope="row" colspan="3">Total including GST</th><td class="num" data-doc="grand">$0</td></tr>
                    </tfoot>
                  </table>

                  <div class="qdoc__cols">
                    <section>
                      <h4>What every quote includes</h4>
                      <ul>{(quote?.inclusions || []).map((t) => <li>{t}</li>)}</ul>
                    </section>
                    <section>
                      <h4>Not included</h4>
                      <ul>{(quote?.exclusions || []).map((t) => <li>{t}</li>)}</ul>
                    </section>
                  </div>

                  {quote?.closingNote && <p class="qdoc__note">{quote.closingNote}</p>}

                  {(quote?.terms || []).length > 0 && (
                    <section class="qdoc__terms">
                      <h4>Terms</h4>
                      <ol>{quote.terms.map((t) => <li>{t}</li>)}</ol>
                    </section>
                  )}

                  <footer class="qdoc__foot">
                    <span>{settings.businessName}</span>
                    <span>{settings.licence}</span>
                    <span>revelectrical.com.au</span>
                  </footer>
                </article>
              </div>
            </section>

            <footer class="wizbar noprint">
              <div class="wizbar__total" id="qb-total-block" hidden>
                <span class="wizbar__label">Running total <em>inc GST</em></span>
                <strong data-total="grand">$0</strong>
                <button class="wizbar__peek" type="button" id="qb-peek" aria-expanded="false" aria-controls="qb-peek-panel">
                  <span data-count>0 items</span> <Icon name="caret" size={13} stroke={2.6} />
                </button>
              </div>
              <div class="wizbar__actions">
                <button class="btn btn-outline btn-sm" type="button" id="qb-back" hidden>Back</button>
                <button class="btn btn-ink btn-sm" type="button" id="qb-next" hidden>
                  Next <Icon name="chevron" size={15} stroke={2.6} />
                </button>
                <button class="btn btn-ink btn-sm" type="button" id="qb-submit" hidden>See my quote</button>
                <button class="btn btn-lime btn-sm" type="button" id="qb-print" hidden>
                  <Icon name="upload" size={15} stroke={2.2} /> Download PDF
                </button>
              </div>
              <div class="wizpeek" id="qb-peek-panel" hidden>
                <ul id="qb-lines"><li class="wizpeek__empty">Nothing selected yet.</li></ul>
              </div>
            </footer>
          </div>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter settings={settings} contactHref="/#contact" />

  <script is:inline define:vars={{ priceData, gst, validDays, jobConfig, stepMeta }}>
    (function () {
      var fmt = function (n) { return '$' + Math.round(n).toLocaleString('en-AU'); };
      var incGst = function (n) { return n * (1 + gst / 100); };
      var BY_ID = {};
      priceData.forEach(function (p) { BY_ID[p.id] = p; });

      priceData.forEach(function (p) {
        var el = document.querySelector('[data-price-display="' + p.id + '"]');
        if (el) el.textContent = fmt(incGst(p.price));
      });

      var STEPS = ['job', 'main', 'extras', 'details', 'quote'];
      var PANE = { job: 'job', main: 'picker', extras: 'picker', details: 'details', quote: 'quote' };

      var selected = {};
      var job = null;
      var step = 0;

      var rails = stepMeta.map(function (s) { return document.querySelector('[data-rail="' + s.key + '"]'); });
      var backBtn = document.getElementById('qb-back');
      var nextBtn = document.getElementById('qb-next');
      var submitBtn = document.getElementById('qb-submit');
      var printBtn = document.getElementById('qb-print');
      var peekBtn = document.getElementById('qb-peek');
      var peekPanel = document.getElementById('qb-peek-panel');
      var totalBlock = document.getElementById('qb-total-block');
      var form = document.getElementById('qb-form');
      var wraps = [].slice.call(document.querySelectorAll('.qbitem__wrap'));

      function lines() {
        return Object.keys(selected).map(function (id) {
          var p = BY_ID[id];
          return { name: p.name, qty: selected[id], each: p.price, amount: p.price * selected[id] };
        });
      }

      function render() {
        var ls = lines();
        var sub = ls.reduce(function (a, l) { return a + l.amount; }, 0);
        document.querySelector('[data-total="grand"]').textContent = fmt(incGst(sub));
        document.querySelector('[data-count]').textContent = ls.length === 1 ? '1 item' : ls.length + ' items';
        document.getElementById('qb-lines').innerHTML = ls.length
          ? ls.map(function (l) {
              return '<li><span>' + l.name + (l.qty > 1 ? ' <em>× ' + l.qty + '</em>' : '') +
                     '</span><span>' + fmt(incGst(l.amount)) + '</span></li>';
            }).join('')
          : '<li class="wizpeek__empty">Nothing selected yet.</li>';
        submitBtn.disabled = ls.length === 0;
      }

      // Steps two and three are the same list shown twice, filtered: the job
      // first, then everything else as extras.
      function fillPicker(which) {
        var cfg = jobConfig[job];
        var cats = which === 'main' ? cfg.cats : cfg.extras;
        wraps.forEach(function (w) { w.hidden = cats.indexOf(w.getAttribute('data-cat')) === -1; });

        var isMain = which === 'main';
        document.querySelector('[data-picker="lead"]').textContent =
          isMain ? cfg.lead : 'Anything else while we are there?';
        document.querySelector('[data-picker="sub"]').textContent =
          isMain ? cfg.sub : 'A second visit costs far more than adding it to this one. Skip if you would rather not.';
        document.querySelector('[data-picker="count"]').textContent =
          'Step ' + (STEPS.indexOf(which) + 1) + ' of ' + STEPS.length;
        document.querySelector('[data-picker="skip"]').textContent =
          isMain ? 'Not sure which one? Pick the closest and we will confirm it.' : 'Nothing you need? Skip straight past.';
      }

      function go(n) {
        step = Math.max(0, Math.min(STEPS.length - 1, n));
        var key = STEPS[step];
        if (key === 'main' || key === 'extras') fillPicker(key);

        Object.keys(PANE).forEach(function (k) {
          var el = document.querySelector('[data-pane="' + PANE[k] + '"]');
          if (el) el.hidden = true;
        });
        document.querySelector('[data-pane="' + PANE[key] + '"]').hidden = false;

        rails.forEach(function (r, i) {
          if (!r) return;
          r.classList.toggle('is-now', i === step);
          r.classList.toggle('is-done', i < step);
        });

        backBtn.hidden = step === 0 || key === 'quote';
        nextBtn.hidden = !(key === 'main' || key === 'extras');
        submitBtn.hidden = key !== 'details';
        printBtn.hidden = key !== 'quote';
        totalBlock.hidden = key === 'job' || key === 'quote';
        peekPanel.hidden = true;
        peekBtn.setAttribute('aria-expanded', 'false');
      }

      // --- choosing the job ---
      document.querySelectorAll('.jobcard').forEach(function (card) {
        card.addEventListener('click', function () {
          var next = card.getAttribute('data-job');
          if (job && job !== next) {
            // Changing the job changes what is on offer, so the basket starts
            // clean rather than carrying items the customer can no longer see.
            selected = {};
            document.querySelectorAll('.qbitem__check').forEach(function (b) { b.checked = false; });
            document.querySelectorAll('.qbqty').forEach(function (q) { q.hidden = true; });
            render();
          }
          job = next;
          document.querySelectorAll('.jobcard').forEach(function (c) {
            c.classList.toggle('is-picked', c === card);
          });
          var label = document.querySelector('[data-rail-label="main"]');
          if (label) label.textContent = jobConfig[job].title;
          go(1);
        });
      });

      // --- selection ---
      document.querySelectorAll('.qbitem__check').forEach(function (box) {
        box.addEventListener('change', function () {
          var id = box.getAttribute('data-item');
          var qtyRow = document.querySelector('[data-qty-for="' + id + '"]');
          if (box.checked) {
            var qty = 1;
            if (qtyRow) { qtyRow.hidden = false; qty = parseInt(qtyRow.querySelector('input').value, 10) || 1; }
            selected[id] = qty;
          } else {
            if (qtyRow) qtyRow.hidden = true;
            delete selected[id];
          }
          render();
        });
      });

      document.querySelectorAll('.qbqty').forEach(function (row) {
        var input = row.querySelector('input');
        var id = input.getAttribute('data-qty-input');
        var clamp = function (v) { return Math.min(Math.max(1, v || 1), parseInt(input.max, 10) || 20); };
        row.querySelectorAll('.qbqty__btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            input.value = clamp((parseInt(input.value, 10) || 1) + parseInt(btn.getAttribute('data-step'), 10));
            if (selected[id] !== undefined) { selected[id] = parseInt(input.value, 10); render(); }
          });
        });
        input.addEventListener('input', function () {
          input.value = clamp(parseInt(input.value, 10));
          if (selected[id] !== undefined) { selected[id] = parseInt(input.value, 10); render(); }
        });
      });

      nextBtn.addEventListener('click', function () { go(step + 1); });
      backBtn.addEventListener('click', function () { go(step - 1); });

      rails.forEach(function (r, i) {
        if (!r || i > 2) return;              // the rail walks back, never ahead
        r.classList.add('is-clickable');
        r.addEventListener('click', function () { if (job || i === 0) go(i); });
      });

      peekBtn.addEventListener('click', function () {
        var open = peekPanel.hidden;
        peekPanel.hidden = !open;
        peekBtn.setAttribute('aria-expanded', String(open));
      });

      function makeRef() {
        var d = new Date();
        return 'RE-' + String(d.getFullYear()).slice(2) +
               String(d.getMonth() + 1).padStart(2, '0') +
               String(d.getDate()).padStart(2, '0') + '-' +
               String(Math.floor(Math.random() * 900) + 100);
      }

      submitBtn.addEventListener('click', function () {
        if (!form.checkValidity()) { form.reportValidity(); return; }

        var ls = lines();
        var sub = ls.reduce(function (a, l) { return a + l.amount; }, 0);
        var ref = makeRef();
        var d = new Date();
        var valid = new Date(d.getTime() + validDays * 86400000);
        var au = function (x) { return x.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' }); };

        document.getElementById('qb-lines-field').value = ls.map(function (l) {
          return l.qty + ' × ' + l.name + ' — ' + fmt(incGst(l.amount));
        }).join('\n');
        document.getElementById('qb-total-field').value = fmt(incGst(sub)) + ' inc GST';
        document.getElementById('qb-ref-field').value = ref;
        document.getElementById('qb-job-field').value = jobConfig[job] ? jobConfig[job].title : '';
        form.querySelector('input[name="page_url"]').value = window.location.href;

        // Amounts are whole dollars excluding GST, matching how they are
        // entered in the Studio and how an accounting package wants them.
        document.getElementById('qb-json-field').value = JSON.stringify({
          quote_ref: ref,
          job_type: jobConfig[job] ? jobConfig[job].title : '',
          issued: d.toISOString().slice(0, 10),
          valid_until: valid.toISOString().slice(0, 10),
          currency: 'AUD',
          gst_rate_percent: gst,
          customer: {
            name: document.getElementById('q_name').value,
            email: document.getElementById('q_email').value,
            phone: document.getElementById('q_phone').value,
            address: document.getElementById('q_address').value,
            notes: document.getElementById('q_notes').value
          },
          line_items: ls.map(function (l) {
            return { description: l.name, quantity: l.qty, unit_price_ex_gst: l.each, amount_ex_gst: l.amount };
          }),
          totals: {
            subtotal_ex_gst: Math.round(sub),
            gst: Math.round(sub * gst / 100),
            total_inc_gst: Math.round(incGst(sub))
          }
        });

        document.querySelector('[data-doc="ref"]').textContent = ref;
        document.querySelector('[data-doc="date"]').textContent = au(d);
        document.querySelector('[data-doc="valid"]').textContent = au(valid);
        document.querySelector('[data-doc="customer"]').innerHTML =
          [document.getElementById('q_name').value, document.getElementById('q_address').value,
           document.getElementById('q_email').value, document.getElementById('q_phone').value]
          .filter(Boolean).join('<br>');
        document.querySelector('[data-doc="lines"]').innerHTML = ls.map(function (l) {
          return '<tr><td>' + l.name + '</td><td class="num">' + l.qty + '</td><td class="num">' +
                 fmt(l.each) + '</td><td class="num">' + fmt(l.amount) + '</td></tr>';
        }).join('');
        document.querySelector('[data-doc="sub"]').textContent = fmt(sub);
        document.querySelector('[data-doc="gst"]').textContent = fmt(sub * gst / 100);
        document.querySelector('[data-doc="grand"]').textContent = fmt(incGst(sub));

        // Posted in the background so the customer keeps the quote on screen
        // rather than being redirected away from what they just built.
        fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form)).toString()
        }).catch(function () { /* the quote still shows; we chase it by phone */ })
          .finally(function () { go(STEPS.indexOf('quote')); });
      });

      printBtn.addEventListener('click', function () { window.print(); });

      render();
      go(0);
    })();
  </script>
</ServiceBase>
