---
import ServiceBase from '../layouts/ServiceBase.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AreaHero from '../components/AreaHero.astro';
import AreaLocal from '../components/AreaLocal.astro';
import CommonJobs from '../components/CommonJobs.astro';
import ServiceAreas from '../components/ServiceAreas.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import Reviews from '../components/Reviews.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqList from '../components/FaqList.astro';
import RebateBand from '../components/RebateBand.astro';
import { sanity } from '../lib/sanity.js';
import { AREA_PATHS_QUERY, AREA_QUERY } from '../lib/queries.js';

export async function getStaticPaths() {
  const areas = await sanity.fetch(AREA_PATHS_QUERY);
  return areas.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const { settings, area, services, reviews, suburbs, areas, contactImage, navBrands, rebates } = await sanity.fetch(AREA_QUERY, { slug });

const canonical = `https://www.revelectrical.com.au/electrician-${area.slug}/`;

// The service cards are the homepage component, so each card title carries the
// suburb rather than the section relying on its heading alone.
const localServices = services.map((s) => ({ ...s, title: `${s.title} in ${area.name}` }));

// The contact block is the homepage one too, fed suburb copy.
const contactCopy = {
  contactHeading: `Get in touch in ${area.name}`,
  contactIntro: `Tell us what you need in ${area.name} and we'll come back within 24 hours with an upfront price.`,
  contactImage
};
---
<ServiceBase
  title={area.seoTitle || `Electrician ${area.name} | ${settings.businessName}`}
  description={area.seoDescription}
  canonical={canonical}
  settings={settings}
  faqs={area.faqs || []}
  areaServed={`${area.name}, Victoria ${area.postcode}`}
  crumbs={[{ name: "Service areas", url: "/service-areas/" }, { name: `Electrician ${area.name}`, url: `/electrician-${area.slug}/` }]}
>
  <SiteHeader settings={settings} services={services} areas={areas} brands={navBrands} />

  <main id="main">
    <AreaHero area={area} settings={settings} />
    <AreaLocal area={area} services={services} />

    <ServiceGrid
      heading={area.servicesHeading}
      intro={area.servicesIntro}
      services={localServices}
      note={`Every job in ${area.name} is completed by tradesmen who are licensed, registered and insured`}
    />

    <RebateBand rebates={rebates} scope="area" place={area.name} />

    <CommonJobs area={area} />

    <Reviews settings={settings} reviews={reviews} />

    <ServiceAreas
      heading={`${area.name} is one of the suburbs we cover.`}
      text={`We work across all areas of Melbourne — so if you're near ${area.name}, we can get to you.`}
      suburbs={suburbs}
      settings={settings}
    />

    {area.faqs && area.faqs.length > 0 && (
      <FaqList service={{ faqEyebrow: 'FAQs', faqHeading: area.faqHeading, faqs: area.faqs }} settings={settings} />
    )}

    <ContactForm page={contactCopy} settings={settings} services={services} />
  </main>

  <SiteFooter settings={settings} />
</ServiceBase>
