---
import Icon from './Icon.astro';
import { img, alt } from '../lib/sanity.js';
const { service, gallery = [] } = Astro.props;
const items = service.diffItems || [];

// Three rows, each pairing a photo with a group of the points. The rows
// alternate side, and any leftover points land in the last row.
const perRow = Math.ceil(items.length / 3) || 1;
const rows = [0, 1, 2]
  .map((i) => items.slice(i * perRow, (i + 1) * perRow))
  .filter((group) => group.length);
const photo = (i) => gallery[i % Math.max(gallery.length, 1)];
---
<section class="section bg-paper" id="why-us">
  <div class="wrap">
    <div class="diff__head reveal">
      {service.diffEyebrow && <p class="eyebrow">{service.diffEyebrow}</p>}
      <h2 class="h2">{service.diffHeading}</h2>
      {service.diffIntro && <p class="lede measure" style="margin-top:18px">{service.diffIntro}</p>}
    </div>

    <div class="diffrows">
      {rows.map((group, r) => (
        <div class={`diffrow reveal ${r % 2 === 1 ? 'diffrow--flip' : ''}`}>
          <figure class="diffrow__media">
            {photo(r) && (
              <img src={img(photo(r).image, 900)} alt={alt(photo(r).image)} width="900" height="700" loading="lazy" />
            )}
          </figure>
          <ul class="difflist">
            {group.map((item) => (
              <li>
                <span class="difflist__tick"><Icon name="checkCircle" size={18} stroke={2.2} /></span>
                <div>
                  <h3 class="h3 difflist__title">{item.title}</h3>
                  <p class="difflist__text">{item.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="btn-row" style="margin-top:clamp(30px,3.4vw,46px)">
      <a class="btn btn-ink" href="#quote">Get a free quote <Icon name="chevron" size={15} stroke={2.6} /></a>
    </div>
  </div>
</section>
