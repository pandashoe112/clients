---
import Icon from './Icon.astro';
import JobTiles from './JobTiles.astro';
import PhotoUpload from './PhotoUpload.astro';
import ContactPrefs from './ContactPrefs.astro';
import Attribution from './Attribution.astro';
import { img, alt } from '../lib/sanity.js';
const { page, settings, services } = Astro.props;

---
<section class="section bg-deep formdark" id="contact">
  <div class="wrap contact__inner">
    <div class="reveal">
      <h2 class="h2">{page.contactHeading}</h2>
      <p class="lede" style="margin-top:18px;max-width:42ch">{page.contactIntro}</p>

      <ul class="contactlist">
        <li>
          <Icon name="mail" size={19} />
          <div><a href={`mailto:${settings.email}?subject=quote%20enquiry`}>{settings.email}</a></div>
        </li>
        <li>
          <Icon name="phone" size={19} />
          <div><a class="js-call" href={settings.phoneHref}>{settings.phone}</a></div>
        </li>
        <li>
          <Icon name="pin" size={19} />
          <div>
            <a href="/service-areas/">All areas of Melbourne</a>
            <span>{settings.licence} · Est. {settings.established}</span>
          </div>
        </li>
      </ul>

      {page.contactImage && (
        <figure class="contact__media">
          <img src={img(page.contactImage, 800)} alt={alt(page.contactImage)} width="800" height="860" loading="lazy" />
        </figure>
      )}
    </div>

    <div class="reveal reveal-d1">
      <form class="formgrid" name="quote-request-contact-section" method="POST" action="/thank-you/"
            data-netlify="true" netlify-honeypot="bot-field"
            enctype="multipart/form-data" id="quoteForm" novalidate>
        <input type="hidden" name="form-name" value="quote-request-contact-section" />
        <p class="hp"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

        <div>
          <label class="label" for="f_name">Name</label>
          <input class="input" type="text" id="f_name" name="name" autocomplete="name" placeholder="First and last name" required aria-describedby="err_name" />
          <p class="err" id="err_name" role="alert"></p>
        </div>

        <div class="formrow">
          <div>
            <label class="label" for="f_email">Email</label>
            <input class="input" type="email" id="f_email" name="email" autocomplete="email" inputmode="email" placeholder="Email address" required aria-describedby="err_email" />
            <p class="err" id="err_email" role="alert"></p>
          </div>
          <div>
            <label class="label" for="f_phone">Phone number</label>
            <input class="input" type="tel" id="f_phone" name="phone" autocomplete="tel" inputmode="tel" placeholder="Phone number" required aria-describedby="err_phone" />
            <p class="err" id="err_phone" role="alert"></p>
          </div>
        </div>

        <div>
          <label class="label" for="f_address">Address</label>
          <input class="input" type="text" id="f_address" name="address" autocomplete="street-address" placeholder="Street address and suburb" required aria-describedby="err_address" />
          <p class="err" id="err_address" role="alert"></p>
        </div>

        <JobTiles idPrefix="c_job" />
        <ContactPrefs idPrefix="c_pref" />
        <PhotoUpload idPrefix="c" />

        <div>
          <label class="label" for="f_message">Message <span class="label__opt">(optional)</span></label>
          <textarea class="input" id="f_message" name="message" placeholder="How can we help.."></textarea>
        </div>

        <button class="btn btn-lime btn-block" type="submit" id="submitBtn">Submit</button>
        {/* The promise sits against the button, not only in the intro above the
            form. It is the last thing read before committing, and it is the answer
            to the question that stops people pressing it: then what happens? */}
        <p class="promise">
          <Icon name="checkCircle" size={15} stroke={2.3} />
          We reply within 24 hours, Mon&ndash;Sat. No call-out fee, no obligation.
        </p>
        <p class="formnote">
          <Icon name="lock" size={15} stroke={2.2} />
          We only use your details to quote your job.
        </p>
        <input type="hidden" name="page_url" id="f_page_url" />
        <input type="hidden" name="subject" value="⚡ New Lead on Revelectrical" />
        {/* Tracking, last so the email opens with the customer, not the UTMs. */}
        <Attribution />
      </form>
    </div>
  </div>
</section>
