---
import { OG_IMAGE } from '../lib/schema.js';
// Open Graph and X card tags. Neither layout had an og:image or a single
// twitter tag, so a link shared anywhere - a text message, a Facebook post,
// a WhatsApp group - rendered as a bare grey box with a URL under it.
//
// One image for the whole site rather than per-page. A per-page card is nicer
// in principle, but a generic card that is always right beats a bespoke one
// that goes stale on 26 pages.
const { title, description, canonical } = Astro.props;
---
<meta property="og:site_name" content="Revelectrical" />
<meta property="og:locale" content="en_AU" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Revelectrical — Melbourne's all-electric electricians" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
