---
import { GTM_ID } from '../lib/gtm.js';

// Google Tag Manager. Kept as an inline script so it runs before the rest of
// the page rather than being bundled and deferred with the site's own JS -
// GTM has to be first for its own timing to mean anything.
const loader = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_ID}');`;
---
<script is:inline set:html={loader}></script>
