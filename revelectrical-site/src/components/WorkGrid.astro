---
const { service } = Astro.props;

// Installs for this service rather than the site-wide gallery.
const WORK = [
  { src: '/photos/evnex_07.webp', cap: 'Wall-mounted home charger' },
  { src: '/photos/evnex_12.webp', cap: 'Smart charger, garage install' },
  { src: '/photos/evnex_10.webp', cap: 'Driveway charge point' }
];
const delay = (i) => (i === 1 ? 'reveal-d1' : i === 2 ? 'reveal-d2' : '');
---
<section class="section bg-cream" id="our-work">
  <div class="wrap">
    <div class="work__head reveal">
      {service.workEyebrow && <p class="eyebrow">{service.workEyebrow}</p>}
      <h2 class="h2">{service.workHeading}</h2>
    </div>
    <ul class="workgrid">
      {WORK.map((item, i) => (
        <li class={`workcard reveal ${delay(i)}`}>
          <img class="workcard__img" src={item.src} alt={item.cap} width="1600" height="1100" loading="lazy" />
          <span class="workcard__cap">{item.cap}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
