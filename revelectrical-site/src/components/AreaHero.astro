---
import Icon from './Icon.astro';
import JobTiles from './JobTiles.astro';
import PhotoUpload from './PhotoUpload.astro';
import ContactPrefs from './ContactPrefs.astro';
import Attribution from './Attribution.astro';
import { img, alt } from '../lib/sanity.js';
const { area, settings } = Astro.props;
const ticks = area.heroTicks || [];

// Suburb photos held as files. A photo uploaded in the Studio wins, so the
// client can replace any of these without touching the code.
// Footscray has no photo of its own yet, so it borrows the Yarraville Village
// shot — the same stretch of the inner west, and the file is named for what it
// actually shows so it can move to a Yarraville page later.
const LOCAL = {
  brunswick: '/suburbs/brunswick.webp',
  coburg: '/suburbs/coburg.webp',
  'moonee-ponds': '/suburbs/moonee-ponds.webp',
  broadmeadows: '/suburbs/broadmeadows.webp',
  essendon: '/suburbs/essendon.webp',
  footscray: '/suburbs/yarraville.webp'
};
const bg = area.heroImage;
const bgFile = !bg && LOCAL[area.slug] ? LOCAL[area.slug] : null;
---
{/* A suburb without a photo yet keeps the same dark hero, just the gradient on
    its own, so every area page reads the same and the section below it (cream)
    still contrasts. */}
<section class="hero hero--photo">
  {(bg || bgFile) && <img class="hero__bg" src={bg ? img(bg, 2000) : bgFile} alt="" aria-hidden="true" />}
  <span class="hero__wash" aria-hidden="true"></span>
  <div class="wrap hero__inner">
    <div class="hero__col">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/service-areas/">Service areas</a>
        <span aria-hidden="true">/</span>
        <span>{area.name}</span>
      </nav>

      <h1 class="h1 hero__title">{area.heroHeading || `Electrician ${area.name}`}</h1>
      <div class="hero__copy lede measure">{area.heroIntro}</div>

      {ticks.length > 0 && (
        <ul class="trustrow">
          {ticks.map((t) => (
            <li class="trustchip"><Icon name="checkCircle" size={17} stroke={2.2} />{t}</li>
          ))}
        </ul>
      )}

      <div class="btn-row hero__actions">
        <a class="btn btn-ink" href="#quote">Get a free quote <Icon name="chevron" size={15} stroke={2.6} /></a>
        <a class="btn btn-outline js-call" href={settings.phoneHref}>Call {settings.phone}</a>
      </div>
    </div>

    <div class="quotecard" id="quote">
      <div class="quotecard__head quotecard__head--plain">
        <h2 class="quotecard__title">Get a free quote</h2>
        <p class="quotecard__sub">Tell us what you need in {area.name} and we'll come back within 24 hours with an upfront price.</p>
      </div>
      <div class="quotecard__body">
        <form class="formgrid" name="quote-request-suburb-hero" method="POST" action="/thank-you/"
              enctype="multipart/form-data"
              data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="quote-request-suburb-hero" />
          <p class="hp"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <div class="fieldrow">
            <div class="field">
              <label class="label" for="a_name">Name</label>
              <input class="input" type="text" id="a_name" name="name" autocomplete="name" placeholder="First and last name" required />
            </div>
            <div class="field">
              <label class="label" for="a_email">Email</label>
              <input class="input" type="email" id="a_email" name="email" autocomplete="email" placeholder="Email address" required />
            </div>
          </div>
          <div class="fieldrow">
            <div class="field">
              <label class="label" for="a_phone">Phone number</label>
              <input class="input" type="tel" id="a_phone" name="phone" autocomplete="tel" placeholder="Phone number" required />
            </div>
            <div class="field">
              <label class="label" for="a_address">Address</label>
              <input class="input" type="text" id="a_address" name="address" autocomplete="street-address" placeholder="Street address and suburb" required />
            </div>
          </div>
          <JobTiles idPrefix="ah_job" />
          <ContactPrefs idPrefix="ah_pref" />
          <PhotoUpload idPrefix="ah" />

          <div class="field">
            <label class="label" for="a_message">Message <span class="label__opt">(optional)</span></label>
            <textarea class="input" id="a_message" name="message" placeholder="How can we help.."></textarea>
          </div>

          <button class="btn btn-ink btn-block" type="submit">Submit</button>
          {/* The promise sits against the button, not only in the intro above the
              form. It is the last thing read before committing, and it is the answer
              to the question that stops people pressing it: then what happens? */}
          <p class="promise">
            <Icon name="checkCircle" size={15} stroke={2.3} />
            We reply within 24 hours, Mon&ndash;Sat. No call-out fee, no obligation.
          </p>
          <p class="formnote">
            <Icon name="lock" size={15} stroke={2.2} />
            We only use your details to quote your job. No obligation to go ahead.
          </p>
          <input type="hidden" name="page_url" />
          <input type="hidden" name="subject" value="⚡ New Lead on Revelectrical" />
          <input type="hidden" name="suburb_page" value={area.name} />
          {/* Tracking, last so the email opens with the customer, not the UTMs. */}
          <Attribution />
        </form>
      </div>
    </div>
  </div>
</section>
