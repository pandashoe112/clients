---
import Icon from './Icon.astro';
import Stars from './Stars.astro';
import { img, alt } from '../lib/sanity.js';
const { page, settings } = Astro.props;
---
<section class="homehero">
  <div class="homehero__panel">
    <div class="homehero__panelin">
      <h1 class="h1 homehero__title">
        {page.heroHeadingStart} <span class="hl">{page.heroHeadingHighlight}</span> {page.heroHeadingEnd}
      </h1>

      <p class="lede measure homehero__lede">{page.heroIntro}</p>

      <ul class="heroticks">
        {page.heroTicks.map((t) => (
          <li><Icon name="checkCircle" size={19} stroke={2.2} />{t}</li>
        ))}
      </ul>

      <div class="btn-row">
        <a class="btn btn-ink" href="#contact">Get a free quote <Icon name="chevron" size={15} stroke={2.6} /></a>
        <a class="btn btn-outline js-call" href={settings.phoneHref}>Call {settings.phone}</a>
      </div>

      <div class="herorating">
        <span class="herorating__num">{settings.ratingValue}</span>
        <div>
          <Stars size={16} />
          <p class="herorating__meta">from {settings.reviewCount} Google reviews</p>
        </div>
      </div>
    </div>
  </div>

  <figure class="homehero__media">
    <img src={img(page.heroImage, 1400)} alt={alt(page.heroImage)} width="1400" height="1200" fetchpriority="high" />
  </figure>
</section>
