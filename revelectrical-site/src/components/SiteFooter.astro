---
import Icon from './Icon.astro';
import { img } from '../lib/sanity.js';
import { rebatesLive } from '../lib/rebates.js';
// Pages carry their quote form under different ids, and some have none at all,
// so the page says where "request a quote" should go.
const { settings, contactHref = '#contact' } = Astro.props;

// Manufacturer certifications, uploaded in the Studio. Only badges with
// artwork render, so a half-filled entry cannot ship a broken image.
const badges = (settings.accreditations || []).filter((b) => b.logo);
---
<footer class="sitefooter">
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <img class="footer__logo" src="/logo-light.webp" alt={settings.businessName} width="196" height="31" loading="lazy" />
        <p class="footer__blurb">A licensed residential electrical contractor helping Melbourne homes go all-electric.</p>
        <ul class="footer__social">
          {settings.instagramUrl && <li><a href={settings.instagramUrl} aria-label="Instagram"><Icon name="instagram" size={18} /></a></li>}
          {settings.facebookUrl && <li><a href={settings.facebookUrl} aria-label="Facebook"><Icon name="facebook" size={18} /></a></li>}
        </ul>

        {badges.length > 0 && (
          <ul class="footer__badges">
            {badges.map((b) => (
              <li>
                {b.url
                  ? <a href={b.url} target="_blank" rel="noopener">
                      <img src={img(b.logo, 320)} alt={b.name} loading="lazy" />
                    </a>
                  : <img src={img(b.logo, 320)} alt={b.name} loading="lazy" />}
              </li>
            ))}
          </ul>
        )}
      </div>
      <div>
        <h2 class="footer__h">Get in touch</h2>
        <ul class="footer__list">
          <li><a class="js-call" href={settings.phoneHref}>{settings.phone}</a></li>
          <li><a href={`mailto:${settings.email}?subject=quote%20enquiry`}>{settings.email}</a></li>
          <li><a href={contactHref}>Request a free quote</a></li>
        </ul>
      </div>
      <div>
        <h2 class="footer__h">Explore</h2>
        {/* These point at the homepage rather than the current page: every one
            of these sections lives there, and only some of them exist on a
            service or suburb page. */}
        <ul class="footer__list">
          <li><a href="/#services">Services</a></li>
          <li><a href="/battery-quote/">Solar battery quote</a></li>
          <li><a href="/#how-it-works">How it works</a></li>
          <li><a href="/service-areas/">Service areas</a></li>
          {rebatesLive && <li><a href="/rebates/">Rebates</a></li>}
          <li><a href="/about/">About us</a></li>
          <li><a href={contactHref}>Contact</a></li>
          <li><a href="/privacy/">Privacy policy</a></li>
        </ul>
      </div>
    </div>
    <div class="footer__bottom">
      <p style="margin:0">{settings.licence} · EST. {settings.established} · Everything Electrification Pty Ltd t/a {settings.businessName}</p>
      <p style="margin:0">revelectrical.com.au</p>
    </div>
  </div>
</footer>
