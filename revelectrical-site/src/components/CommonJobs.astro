---
import Icon from './Icon.astro';
import { img, alt } from '../lib/sanity.js';
const { area } = Astro.props;
const jobs = area.commonJobs || [];

// The suburb photo, same source as the hero: an uploaded one wins, otherwise
// the file that ships with the site.
const LOCAL = {
  brunswick: '/suburbs/brunswick.webp',
  coburg: '/suburbs/coburg.webp',
  'moonee-ponds': '/suburbs/moonee-ponds.webp',
  broadmeadows: '/suburbs/broadmeadows.webp'
};
// Its own photo where one is set, otherwise the hero - which is better than
// nothing but shows the same shot twice on one page.
const own = area.jobsImage || area.heroImage;
const photo = own ? img(own, 1100) : LOCAL[area.slug];
const photoAlt = own ? alt(own) : `${area.name}, Melbourne`;
---
{jobs.length > 0 && (
  <section class="section bg-paper" id="common-jobs">
    <div class="wrap jobs__inner">
      {photo && (
        <figure class="jobs__media reveal">
          <img src={photo} alt={photoAlt} width="1100" height="1200" loading="lazy" />
        </figure>
      )}

      <div class="jobs__body reveal reveal-d1">
        <p class="eyebrow">In {area.name}</p>
        <h2 class="h2">{area.jobsHeading || `What we get called out for in ${area.name}`}</h2>
        {area.jobsIntro && <p class="lede measure" style="margin-top:16px">{area.jobsIntro}</p>}

        <ul class="joblist">
          {jobs.map((job) => (
            <li>
              <span class="joblist__tick" aria-hidden="true"><Icon name="check" size={15} stroke={2.8} /></span>
              {job.service && job.service.hasPage
                ? <a class="joblist__link" href={`/services/${job.service.slug}/`}>{job.title}<Icon name="chevron" size={13} stroke={2.6} /></a>
                : <span class="joblist__plain">{job.title}</span>}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
)}
