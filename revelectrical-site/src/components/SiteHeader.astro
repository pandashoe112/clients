---
import Icon from './Icon.astro';
const { settings, services, areas = [] } = Astro.props;
---
<div class="utilbar">
  <div class="wrap utilbar__inner">
    <span class="utilbar__lic">
      <span class="utilbar__licfull">{settings.licence}</span>
      <span class="utilbar__dot" aria-hidden="true"></span>
      Licensed and insured
    </span>
    <div class="utilbar__links">
      <a class="utilbar__link utilbar__link-email" href={`mailto:${settings.email}?subject=quote%20enquiry`}>{settings.email}</a>
    </div>
  </div>
</div>

<header class="siteheader" id="siteheader">
  <div class="wrap siteheader__inner">
    <a class="siteheader__logo" href="/" aria-label={`${settings.businessName} home`}>
      <img src="/logo.webp" alt={settings.businessName} width="178" height="29" />
    </a>

    <nav class="sitenav" aria-label="Main">
      <div class="navitem" data-dropdown>
        <button class="navlink" type="button" aria-expanded="false" aria-controls="dd-services">
          Our services
          <span class="navlink__caret"><Icon name="caret" size={13} stroke={2.6} /></span>
        </button>
        <div class="dropdown" id="dd-services">
          {services.map((s) => (
            <a class="dropdown__link" href={s.hasPage ? `/services/${s.slug.current}` : `/#svc-${s.slug.current}`}>{s.title}</a>
          ))}
        </div>
      </div>
      {areas.length > 0 ? (
        <div class="navitem" data-dropdown>
          <button class="navlink" type="button" aria-expanded="false" aria-controls="dd-areas">
            Service areas
            <span class="navlink__caret"><Icon name="caret" size={13} stroke={2.6} /></span>
          </button>
          <div class="dropdown" id="dd-areas">
            {areas.map((a) => (
              <a class="dropdown__link" href={`/electrician-${a.slug}/`}>{a.name} <span class="dropdown__pc">{a.postcode}</span></a>
            ))}
            <a class="dropdown__link dropdown__link--all" href="/service-areas/">All service areas</a>
          </div>
        </div>
      ) : (
        <a class="navlink" href="/#service-areas">Service areas</a>
      )}
      <a class="navlink" href="/#about">About us</a>
      <a class="navlink" href="/#gallery">Gallery</a>
    </nav>

    <div class="siteheader__actions">
      <a class="callblock js-call" href={settings.phoneHref}>
        <span class="callblock__icon"><Icon name="phone" size={18} stroke={2.2} /></span>
        <span>
          <span class="callblock__label">Call us first</span>
          <span class="callblock__num">{settings.phone}</span>
        </span>
      </a>
      <a class="btn btn-ink btn-sm" href="#contact">Contact us <Icon name="chevron" size={15} stroke={2.6} /></a>
    </div>
  </div>
</header>
