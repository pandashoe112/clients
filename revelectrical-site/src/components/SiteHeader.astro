---
import Icon from './Icon.astro';
// Pages carry their quote form under different ids, and some have none at all,
// so the page says where the contact buttons should go.
const { settings, services, areas = [], brands = [], contactHref = '#contact' } = Astro.props;

// A brand without a page still belongs in the menu — it says what we install.
// It renders as plain text rather than a dead link.
const KIND = { charger: 'EV chargers', battery: 'Batteries', both: 'Chargers and batteries' };
---
<div class="utilbar">
  <div class="wrap utilbar__inner">
    <span class="utilbar__lic">
      <span class="utilbar__licfull">{settings.licence}</span>
      <span class="utilbar__dot" aria-hidden="true"></span>
      Licensed and insured
    </span>
    <div class="utilbar__links">
      <a class="utilbar__link utilbar__link-email" href={`mailto:${settings.email}?subject=quote%20enquiry`}>{settings.email}</a>
    </div>
  </div>
</div>

<header class="siteheader" id="siteheader">
  <div class="wrap siteheader__inner">
    <a class="siteheader__logo" href="/" aria-label={`${settings.businessName} home`}>
      <img src="/logo.webp" alt={settings.businessName} width="178" height="28" />
    </a>

    <nav class="sitenav" aria-label="Main">
      <div class="navitem" data-dropdown>
        <button class="navlink" type="button" aria-expanded="false" aria-controls="dd-services">
          Our services
          <span class="navlink__caret"><Icon name="caret" size={13} stroke={2.6} /></span>
        </button>
        <div class="dropdown" id="dd-services">
          {services.map((s) => (
            <a class="dropdown__link" href={s.hasPage ? `/services/${s.slug.current}` : `/#svc-${s.slug.current}`}>{s.title}</a>
          ))}
        </div>
      </div>
      {brands.length > 0 && (
        <div class="navitem" data-dropdown>
          <button class="navlink" type="button" aria-expanded="false" aria-controls="dd-brands">
            Brands we install
            <span class="navlink__caret"><Icon name="caret" size={13} stroke={2.6} /></span>
          </button>
          <div class="dropdown" id="dd-brands">
            {brands.map((b) => (
              b.hasPage
                ? <a class="dropdown__link" href={`/brands/${b.slug}/`}>{b.name} <span class="dropdown__pc">{KIND[b.kind]}</span></a>
                : <span class="dropdown__link dropdown__link--soon">{b.name} <span class="dropdown__pc">Coming soon</span></span>
            ))}
            <a class="dropdown__link dropdown__link--all" href="/brands/">All brands we install</a>
          </div>
        </div>
      )}
      {areas.length > 0 ? (
        <div class="navitem" data-dropdown>
          <button class="navlink" type="button" aria-expanded="false" aria-controls="dd-areas">
            Service areas
            <span class="navlink__caret"><Icon name="caret" size={13} stroke={2.6} /></span>
          </button>
          <div class="dropdown" id="dd-areas">
            {areas.map((a) => (
              <a class="dropdown__link" href={`/electrician-${a.slug}/`}>{a.name} <span class="dropdown__pc">{a.postcode}</span></a>
            ))}
            <a class="dropdown__link dropdown__link--all" href="/service-areas/">All service areas</a>
          </div>
        </div>
      ) : (
        <a class="navlink" href="/service-areas/">Service areas</a>
      )}
      <a class="navlink" href="/about/">About us</a>
    </nav>

    <div class="siteheader__actions">
      <a class="callblock js-call" href={settings.phoneHref}>
        <span class="callblock__icon"><Icon name="phone" size={18} stroke={2.2} /></span>
        <span>
          <span class="callblock__label">Call us first</span>
          <span class="callblock__num">{settings.phone}</span>
        </span>
      </a>
      <a class="btn btn-ink btn-sm siteheader__cta" href={contactHref}>Contact us <Icon name="chevron" size={15} stroke={2.6} /></a>

      <button class="burger" id="burger" type="button" aria-expanded="false" aria-controls="mobilenav">
        <span class="burger__bars" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>

  {/* The nav collapses out of the bar below 1080px, so it reappears here.
      <details> carries the accordions, which keeps them working if the
      toggle script never runs. */}
  <div class="mobilenav" id="mobilenav">
    <div class="wrap mobilenav__inner">
      <details class="mnav__group">
        <summary class="mnav__summary">Our services <Icon name="caret" size={14} stroke={2.6} /></summary>
        <div class="mnav__sub">
          {services.map((s) => (
            <a class="mnav__sublink" href={s.hasPage ? `/services/${s.slug.current}/` : `/#svc-${s.slug.current}`}>{s.title}</a>
          ))}
        </div>
      </details>

      {brands.length > 0 && (
        <details class="mnav__group">
          <summary class="mnav__summary">Brands we install <Icon name="caret" size={14} stroke={2.6} /></summary>
          <div class="mnav__sub">
            {brands.map((b) => (
              b.hasPage
                ? <a class="mnav__sublink" href={`/brands/${b.slug}/`}>{b.name} <span class="mnav__pc">{KIND[b.kind]}</span></a>
                : <span class="mnav__sublink mnav__sublink--soon">{b.name} <span class="mnav__pc">Coming soon</span></span>
            ))}
            <a class="mnav__sublink mnav__sublink--all" href="/brands/">All brands we install</a>
          </div>
        </details>
      )}

      {areas.length > 0 ? (
        <details class="mnav__group">
          <summary class="mnav__summary">Service areas <Icon name="caret" size={14} stroke={2.6} /></summary>
          <div class="mnav__sub">
            {areas.map((a) => (
              <a class="mnav__sublink" href={`/electrician-${a.slug}/`}>{a.name} <span class="mnav__pc">{a.postcode}</span></a>
            ))}
            <a class="mnav__sublink mnav__sublink--all" href="/service-areas/">All service areas</a>
          </div>
        </details>
      ) : (
        <a class="mnav__link" href="/service-areas/">Service areas</a>
      )}

      <a class="mnav__link" href="/about/">About us</a>

      <div class="mnav__cta">
        <a class="btn btn-ink btn-block" href={contactHref}>Get a free quote <Icon name="chevron" size={15} stroke={2.6} /></a>
        <a class="btn btn-outline btn-block js-call" href={settings.phoneHref}>Call {settings.phone}</a>
      </div>
    </div>
  </div>

</header>

{/* Without this the page shows through below the panel, which reads as part of
    the menu — the hero's own call button ends up directly under the panel's. It
    sits outside the header so it dims the page without tinting the bar. */}
<div class="navscrim" id="navscrim" aria-hidden="true"></div>
