---
// Central icon set. Components ask for an icon by name so the CMS can store a
// plain string ("shield") rather than markup the client could break.
const { name, size = 20, stroke = 2 } = Astro.props;

const paths = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
  document: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="m9 15 2 2 4-4"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>',
  tag: '<path d="M20.6 13.4 12 22l-9-9V3h10l7.6 7.6a2 2 0 0 1 0 2.8Z"/><circle cx="7.5" cy="7.5" r="1.3"/>',
  calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/><path d="m9 15 2 2 4-4"/>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/>',
  mail: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  check: '<path d="M20 6 9 17l-5-5"/>',
  checkCircle: '<circle cx="12" cy="12" r="9"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
  chevron: '<path d="m9 6 6 6-6 6"/>',
  arrowLeft: '<path d="M19 12H5M11 18l-6-6 6-6"/>',
  arrowRight: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  caret: '<path d="m6 9 6 6 6-6"/>',
  close: '<path d="M18 6 6 18M6 6l12 12"/>',
  lock: '<rect x="3" y="11" width="18" height="10" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
  upload: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M12 3v13M7 8l5-5 5 5"/>',
  instagram: '<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.1" fill="currentColor" stroke="none"/>',
  facebook: '<path d="M15 2h-3a4 4 0 0 0-4 4v3H5v4h3v9h4v-9h3l1-4h-4V6a1 1 0 0 1 1-1h3Z"/>',

  // Job types, for the tiles on the enquiry forms. Drawn on the same 24 grid
  // and at the same weight as the set above, so a tile row does not look like
  // it was assembled from two different icon libraries.
  jobEv:         '<rect x="3" y="4" width="11" height="17" rx="2"/><path d="M6.5 9.5h4M8.5 7.5v4"/><path d="M14 9h3a2 2 0 0 1 2 2v5a1.5 1.5 0 0 0 3 0v-6l-2-2"/>',
  jobBattery:    '<rect x="2" y="7" width="16" height="11" rx="2"/><path d="M18 11h2a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1h-2"/><path d="m10 9.5-2 3h3l-2 3"/>',
  jobHotWater:   '<path d="M12 2.7s5.2 5 5.2 8.6a5.2 5.2 0 1 1-10.4 0C6.8 7.7 12 2.7 12 2.7Z"/><path d="M9.7 12.4a2.6 2.6 0 0 0 2.6 2.6"/>',
  jobBoard:      '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M7.5 12v5M12 12v5M16.5 12v5"/>',
  jobLight:      '<path d="M9 17.5h6"/><path d="M10 21h4"/><path d="M12 2a6 6 0 0 0-3.5 10.9c.5.4.8 1 .8 1.6h5.4c0-.6.3-1.2.8-1.6A6 6 0 0 0 12 2Z"/>',
  jobPower:      '<rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="9" cy="10" r="1.3"/><circle cx="15" cy="10" r="1.3"/><path d="M8.5 15.5h7"/>',
  jobInduction:  '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="2.2"/><circle cx="15.5" cy="9.5" r="2.2"/><path d="M6.5 15.5h11"/>',
  jobFan:        '<circle cx="12" cy="12" r="1.8"/><path d="M12 10.2C12 7 13.4 4 15.5 4S19 6 17.2 8.4c-1.2 1.5-3 2-5.2 1.8Z"/><path d="M13.8 12c3.2 0 6.2 1.4 6.2 3.5S18 19 15.6 17.2c-1.5-1.2-2-3-1.8-5.2Z"/><path d="M10.2 12C7 12 4 10.6 4 8.5S6 5 8.4 6.8c1.5 1.2 2 3 1.8 5.2Z"/><path d="M12 13.8c0 3.2-1.4 6.2-3.5 6.2S5 18 6.8 15.6c1.2-1.5 3-2 5.2-1.8Z"/>',
  jobSmoke:      '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="2"/><path d="M12 3.5v2M12 18.5v2M3.5 12h2M18.5 12h2"/>',
  jobSafety:     '<rect x="4" y="3" width="16" height="18" rx="2"/><path d="M12 7v4"/><circle cx="12" cy="15" r="2.2"/>',
  jobFault:      '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.7-4.7"/><path d="m11 7-2.2 3.4h2.6L9.6 14"/>',
  jobOther:      '<circle cx="5.5" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="18.5" cy="12" r="1.4"/>'
};

const d = paths[name] || paths.check;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width={stroke} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={d}></svg>
