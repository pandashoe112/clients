---
// How to reach them. One compact chip row.
//
// Phone tag is where jobs get lost: we ring at 11am, they are on site, they
// ring back at 6pm, we are under a house. One tap removes most of that, and it
// is not required - an unanswered optional question should never be the reason
// an enquiry does not get sent.
//
// There was a "Best time" row beside this one. The client asked for it to go:
// two optional questions in a row is one more than an enquiry form can afford,
// and at four columns "Afternoon" did not fit its chip.
const { idPrefix = 'pref' } = Astro.props;
const CONTACT = ['Call', 'Text', 'Email'];
---
<div class="prefs">
  <fieldset class="tileset">
    <legend class="label">Best way to reach you <span class="label__opt">Optional</span></legend>
    <div class="tilegrid tilegrid--slim">
      {CONTACT.map((c, i) => (
        <div class="tile">
          <input type="radio" name="preferred_contact" id={`${idPrefix}_c${i}`} value={c} />
          <label for={`${idPrefix}_c${i}`}>{c}</label>
        </div>
      ))}
    </div>
  </fieldset>
</div>
