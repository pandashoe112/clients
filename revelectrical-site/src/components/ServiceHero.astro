---
import Icon from './Icon.astro';
import { img } from '../lib/sanity.js';
// brandLogo and parent are only passed by the brand pages, which sit a level
// deeper than a service and lead with the manufacturer's mark.
const { service, settings, services, brandLogo, parent } = Astro.props;
const ticks = service.heroTicks || [];
---
<section class="hero bg-cream">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <div class="hero__col">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        {parent && (
          <>
            <a href={parent.href}>{parent.label}</a>
            <span aria-hidden="true">/</span>
          </>
        )}
        <span>{service.title}</span>
      </nav>

      {brandLogo && (
        <p class="brandmark"><img src={img(brandLogo, 260)} alt={service.title} loading="eager" /></p>
      )}

      <h1 class="h1 hero__title">{service.heroHeading || service.title}</h1>
      <div class="hero__copy lede measure">{service.heroIntro}</div>

      {ticks.length > 0 && (
        <ul class="trustrow">
          {ticks.map((t) => (
            <li class="trustchip"><Icon name="checkCircle" size={17} stroke={2.2} />{t}</li>
          ))}
        </ul>
      )}

      <div class="btn-row hero__actions">
        <a class="btn btn-ink" href="#quote">Get a free quote <Icon name="chevron" size={15} stroke={2.6} /></a>
        <a class="btn btn-outline js-call" href={settings.phoneHref}>Call {settings.phone}</a>
      </div>
    </div>

    <div class="quotecard" id="quote">
      <div class="quotecard__head quotecard__head--plain">
        <h2 class="quotecard__title">{service.quoteHeading || 'Get a free quote'}</h2>
        <p class="quotecard__sub">{service.quoteText}</p>
      </div>
      <div class="quotecard__body">
        <form class="formgrid" name="quote-request-service-hero" method="POST" action="/thank-you/"
              data-netlify="true" netlify-honeypot="bot-field" id="quoteForm" novalidate>
          <input type="hidden" name="form-name" value="quote-request-service-hero" />
          <input type="hidden" name="page_url" />
          <input type="hidden" name="subject" value="⚡ New enquiry from a service page" />
          <input type="hidden" name="service_page" value={service.title} />
          <p class="hp"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          <div class="field">
            <label class="label" for="f_name">Name</label>
            <input class="input" type="text" id="f_name" name="name" autocomplete="name" placeholder="First and last name" required />
          </div>
          <div class="field">
            <label class="label" for="f_email">Email</label>
            <input class="input" type="email" id="f_email" name="email" autocomplete="email" placeholder="Email address" required />
          </div>
          <div class="field">
            <label class="label" for="f_phone">Phone number</label>
            <input class="input" type="tel" id="f_phone" name="phone" autocomplete="tel" placeholder="Phone number" required />
          </div>
          <div class="field">
            <label class="label" for="f_address">Address</label>
            <input class="input" type="text" id="f_address" name="address" autocomplete="street-address" placeholder="Street address and suburb" required />
          </div>
          <div class="field">
            <label class="label" for="f_message">Message <span class="label__opt">(optional)</span></label>
            <textarea class="input" id="f_message" name="message" placeholder="How can we help.."></textarea>
          </div>

          <button class="btn btn-ink btn-block" type="submit">Submit</button>
          <p class="formnote">
            <Icon name="lock" size={15} stroke={2.2} />
            We only use your details to quote your job. No obligation to go ahead.
          </p>
          </form>
      </div>
    </div>
  </div>
</section>
