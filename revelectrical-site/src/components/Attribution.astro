---
// Where the enquiry came from. One block of hidden fields, dropped into the
// bottom of every form on the site and filled in by src/scripts/attribution.js.
//
// It sits at the bottom deliberately. Netlify emails fields in DOM order, so
// with this block at the top the notification opened with six blank UTM lines
// and buried the customer's name and phone number below them.
//
// The fields are rendered with no value on purpose. Netlify registers a form's
// fields by parsing the built HTML at deploy time, so the inputs have to exist
// in the static markup even though the browser is what fills them. Any that
// are still empty at submit are disabled by site.js so they drop out of the
// email entirely rather than printing as a blank line.
//
// Names are chosen for how Netlify renders them: it title-cases the `name`
// attribute, so `lead_source` reads as "Lead Source" in the email.
const FIELDS = [
  'lead_source',
  'utm_campaign',
  'utm_source',
  'utm_medium',
  'utm_term',
  'utm_content',
  'ad_click_id',
  'landing_page',
  'came_from',
  'first_seen'
];
---
{FIELDS.map((name) => <input type="hidden" name={name} data-attr={name} />)}
