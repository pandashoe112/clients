---
import Icon from './Icon.astro';
import { img, alt } from '../lib/sanity.js';
const { area, services = [] } = Astro.props;
const body = area.localBody || [];
---
<section class="section bg-cream">
  <div class="wrap guarantee__inner">
    <div class="guarantee__body reveal">
      <p class="eyebrow">In {area.name}</p>
      <h2 class="h2">{area.localHeading}</h2>
      {body.map((p) => <p class="lede" style="margin-top:18px">{p}</p>)}

      {services.length > 0 && (
        <ul class="localticks">
          {services.map((s) => (
            <li><Icon name="checkCircle" size={18} stroke={2.2} />{s.title}</li>
          ))}
        </ul>
      )}
    </div>
    {area.localImage && (
      <figure class="guarantee__figure reveal reveal-d1">
        <img src={img(area.localImage, 800)} alt={alt(area.localImage)} width="800" height="800" loading="lazy" />
      </figure>
    )}
  </div>
</section>
