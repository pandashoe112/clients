---
import Icon from './Icon.astro';

// Step two of the enquiry. The first form exists to catch the contact details
// before someone leaves; this one asks the questions that decide the price.
// Every question maps to a variable in the quoting model - hardware, cable run,
// access difficulty, switchboard condition and phases - so a completed form is
// enough to draft a proposal from without a site visit.
//
// It shows no prices. Pricing stays internal: the customer sees a proposal only
// once it has been checked and sent.
const { settings } = Astro.props;

const CHARGERS = [
  'Evnex E2 Flex', 'Evnex E2 Core', 'Evnex E2 Plus', 'Evnex X22',
  'Another brand', 'Not sure - recommend one'
];
const RUNS = [
  'Under 5 metres', '5 to 10 metres', '10 to 20 metres', 'Over 20 metres', 'Not sure'
];
const ACCESS = [
  'Roof space is accessible',
  'Under-floor or crawl space',
  'Would need surface-mounted conduit',
  'Solid walls / rendered brick',
  'Not sure'
];
const BOARD = [
  'Recent, with safety switches',
  'Older, but has some safety switches',
  'Old ceramic fuses',
  'Not sure'
];
const PHASE = ['Single phase', 'Three phase', 'Not sure'];
const WHEN = ['As soon as possible', 'In the next few weeks', 'In the next few months', 'Just planning'];
---
<section class="section bg-paper" id="job-details">
  <div class="wrap details__inner">
    <div class="reveal">
      <p class="eyebrow">Optional, but worth two minutes</p>
      <h2 class="h2" style="margin-top:12px">Want your price sooner?</h2>
      <p class="lede" style="margin-top:18px;max-width:46ch">
        The questions below are the ones we would ask on the phone anyway. Answer what you
        can and we can usually price the job without visiting first — photos help most of all.
      </p>
      <ul class="detailwhy">
        <li><Icon name="checkCircle" size={18} stroke={2.2} /> Skip the back-and-forth phone tag</li>
        <li><Icon name="checkCircle" size={18} stroke={2.2} /> Get a firmer number, not a rough range</li>
        <li><Icon name="checkCircle" size={18} stroke={2.2} /> Nothing here commits you to anything</li>
      </ul>
      <p class="detailnote">
        Not sure on something? Leave it — "not sure" is a perfectly good answer and we will
        work it out with you.
      </p>
    </div>

    <div class="quotecard reveal reveal-d1">
      <div class="quotecard__head quotecard__head--plain">
        <h3 class="quotecard__title">A few more details</h3>
        <p class="quotecard__sub">So we can put a firm number on it.</p>
      </div>
      <div class="quotecard__body">
        <form class="formgrid" name="job-details" method="POST" action="/thank-you/?detailed=1"
              data-netlify="true" netlify-honeypot="bot-field" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="form-name" value="job-details" />
          <input type="hidden" name="page_url" />
          <input type="hidden" name="subject" value="🔧 Job details for a quote" />
          <p class="hp"><label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>

          {/* Email is how these answers get matched back to the enquiry that
              came through a minute earlier. */}
          <div class="field">
            <label class="label" for="d_email">Your email</label>
            <input class="input" type="email" id="d_email" name="email" autocomplete="email"
                   placeholder="The same one you just used" required aria-describedby="err_email" />
            <p class="err" id="err_email" role="alert"></p>
          </div>

          <div class="field">
            <label class="label" for="d_charger">Which charger are you after?</label>
            <select class="input select" id="d_charger" name="charger">
              <option value="">Choose one</option>
              {CHARGERS.map((c) => <option value={c}>{c}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="label" for="d_run">How far is the charger spot from your switchboard?</label>
            <select class="input select" id="d_run" name="cable_run">
              <option value="">Choose one</option>
              {RUNS.map((r) => <option value={r}>{r}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="label" for="d_access">How would the cable get there?</label>
            <select class="input select" id="d_access" name="access">
              <option value="">Choose one</option>
              {ACCESS.map((a) => <option value={a}>{a}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="label" for="d_board">What shape is your switchboard in?</label>
            <select class="input select" id="d_board" name="switchboard">
              <option value="">Choose one</option>
              {BOARD.map((b) => <option value={b}>{b}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="label" for="d_phase">Single or three phase?</label>
            <select class="input select" id="d_phase" name="phases">
              <option value="">Choose one</option>
              {PHASE.map((p) => <option value={p}>{p}</option>)}
            </select>
          </div>

          <div class="field">
            <label class="label" for="d_when">When are you hoping to have it done?</label>
            <select class="input select" id="d_when" name="timing">
              <option value="">Choose one</option>
              {WHEN.map((w) => <option value={w}>{w}</option>)}
            </select>
          </div>

          {/* Photos do more for pricing accuracy than every dropdown above. */}
          <div class="field">
            <label class="label" for="d_photos">
              Photos <span class="label__opt">(switchboard, meter box, and where the charger goes)</span>
            </label>
            <div class="filerow">
              <label class="filebtn" for="d_photos"><Icon name="upload" size={17} /> Upload photos</label>
              <input type="file" id="d_photos" name="photos" multiple accept="image/*,video/*" />
            </div>
            <p class="detailhint">These tell us more than anything else here. Even a quick phone snap helps.</p>
          </div>

          <div class="field">
            <label class="label" for="d_notes">Anything else we should know? <span class="label__opt">(optional)</span></label>
            <textarea class="input" id="d_notes" name="notes"
                      placeholder="Solar on the roof, second car coming, awkward access, whatever comes to mind"></textarea>
          </div>

          <button class="btn btn-ink btn-block" type="submit">Send these details</button>
          <p class="formnote">
            <Icon name="lock" size={15} stroke={2.2} />
            Only used to price your job. We will not add you to a mailing list.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>
