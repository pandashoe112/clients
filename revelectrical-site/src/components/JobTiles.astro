---
import Icon from './Icon.astro';
// The job-type picker, shared by every enquiry form on the site.
//
// Multi-select, because real enquiries are rarely one job: a charger usually
// needs the board looked at, and someone going all-electric is asking about
// three things at once. Making it single-choice was throwing that away and
// forcing the caller to explain it again on the phone.
//
// Twelve options rather than the six service pages. The list is the jobs
// people recognise and use their own words for, not our page structure, and
// "Something else" catches the rest so a lead is never lost to a missing
// option.
//
// On a service page the matching tile arrives ticked and the visitor adds to
// it, which is the whole point of multi-select: they came for a charger and
// can now also say the switchboard is ancient.
const { idPrefix = 'job', selected = '' } = Astro.props;

const JOBS = [
  { label: 'EV charging',           icon: 'jobEv' },
  { label: 'Solar & battery',       icon: 'jobBattery' },
  { label: 'Hot water',             icon: 'jobHotWater' },
  { label: 'Switchboard',           icon: 'jobBoard' },
  { label: 'Lighting',              icon: 'jobLight' },
  { label: 'Power points',          icon: 'jobPower' },
  { label: 'Induction cooktop',     icon: 'jobInduction' },
  { label: 'Ceiling fans',          icon: 'jobFan' },
  { label: 'Smoke alarms',          icon: 'jobSmoke' },
  { label: 'Safety switch',         icon: 'jobSafety' },
  { label: 'Fault finding',         icon: 'jobFault' },
  { label: 'Something else',        icon: 'jobOther' }
];

// Service pages name themselves differently to these buckets, so match on the
// words rather than expecting the titles to line up.
const MATCH = [
  [/ev|charger|charging/i, 'EV charging'],
  [/solar|batter/i, 'Solar & battery'],
  [/hot water|heat pump/i, 'Hot water'],
  [/switchboard|fuse|rewir/i, 'Switchboard'],
  [/light|downlight|led/i, 'Lighting'],
  [/induction|cooktop|oven/i, 'Induction cooktop']
];
const preset = selected
  ? (MATCH.find(([re]) => re.test(selected)) || [])[1] || ''
  : '';
const evOpen = preset === 'EV charging' || preset === 'Solar & battery';
---
{/* A fieldset with a real legend, so a screen reader announces the group
    before reading twelve checkboxes. aria-describedby points every box at the
    one error line, which is where "pick at least one" lands. */}
<fieldset class="tileset" id={`${idPrefix}_set`}>
  <legend class="label">
    What do you need?
    <span class="label__hint">Pick as many as apply</span>
    {/* Filled by site.js. Silent until something is chosen, so the form does
        not open by telling you that you have selected nothing. */}
    <span class="tilecount" data-tilecount hidden></span>
  </legend>
  <div class="tilegrid tilegrid--multi">
    {JOBS.map((job, i) => (
      <div class="tile">
        <input
          type="checkbox"
          name="services_selected"
          id={`${idPrefix}_${i}`}
          value={job.label}
          checked={job.label === preset}
          data-required-group="services_selected"
          aria-describedby={`${idPrefix}_err`}
        />
        <label for={`${idPrefix}_${i}`}>
          <span class="tile__icon"><Icon name={job.icon} size={19} stroke={1.7} /></span>
          <span class="tile__text">{job.label}</span>
        </label>
      </div>
    ))}
  </div>
  <p class="err" id={`${idPrefix}_err`} role="alert"></p>
</fieldset>

{/* Follow-up that only exists once EV charging is picked. The charger has to
    match the car's plug and onboard charger rate, so knowing the model is the
    difference between quoting from a photo and quoting properly.

    The initial state is rendered server-side, so on a service page where the
    tile arrives pre-ticked the panel is already open rather than appearing a
    moment after the page settles. site.js toggles it from there. */}
<div class="condfield" data-cond="ev" hidden={!evOpen}>
  <label class="label" for={`${idPrefix}_car`}>
    What are you charging? <span class="label__opt">Optional</span>
  </label>
  <input
    class="input"
    type="text"
    id={`${idPrefix}_car`}
    name="vehicle"
    autocomplete="off"
    placeholder="Car make and model, e.g. Tesla Model Y" />
  <p class="condfield__why">Helps us match the charger to your car's plug and charge rate.</p>

  {/* The question Ben says separates us from a general electrician: we are
      accredited to design the charger around an existing solar or battery
      setup. Knowing the answer before the callback means he can lead with it
      rather than discover it halfway through the conversation. */}
  <fieldset class="tileset" style="margin-top:16px">
    <legend class="label">Do you have solar or a battery? <span class="label__opt">Optional</span></legend>
    <div class="tilegrid tilegrid--slim">
      {['Solar', 'Solar + battery', 'Neither yet'].map((opt, i) => (
        <div class="tile">
          <input type="radio" name="solar_or_battery" id={`${idPrefix}_sb${i}`} value={opt} />
          <label for={`${idPrefix}_sb${i}`}>{opt}</label>
        </div>
      ))}
    </div>
  </fieldset>
</div>
