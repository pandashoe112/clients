---
import BatteryQuoteForm from './BatteryQuoteForm.astro';
import Icon from './Icon.astro';
// The battery quote form plus the reason to fill it in, as one section.
//
// Used in two places: the standalone /battery-quote/ page, and in place of the
// generic enquiry form at the foot of /services/solar-battery/. Ben's brief
// was that this replaces a generic contact form, so on the battery page it is
// the form, not a link to one.
const { settings, heading, intro, level = 2 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
// On its own page this is the form, so it takes #quote. Bolted to the foot of
// the solar battery service page it is the second form there - the short hero
// one already owns #quote - and two elements cannot share an id. Every #quote
// link on that page was landing on the hero card, which is the right
// destination for a general "contact us" anyway; this one gets its own anchor.
const anchor = level === 1 ? 'quote' : 'battery-quote';

const WHY = [
  {
    title: 'A real number, not a range',
    text: 'Enough detail to price the battery, the switchboard work and the cable run together, rather than quoting a band and revising it after a visit.'
  },
  {
    title: 'Often no site visit first',
    text: 'With photos of the board and the spot, we can usually quote from the desk and only come out to install.'
  },
  {
    title: 'Sized on your usage, not a guess',
    text: 'Your bill and your solar tell us what you actually use and when, which is what decides the capacity.'
  }
];
---
<section class="section bg-cream" id={anchor}>
  <div class="wrap bqpage">
    <div class="bqpage__intro reveal">
      <p class="eyebrow">Battery storage</p>
      <H class={level === 1 ? 'h1' : 'h2'} style="margin-top:12px;max-width:16ch">
        {heading || 'Free battery storage assessment in Melbourne'}
      </H>
      <p class="lede" style="margin-top:20px;max-width:44ch">
        {intro || "Tell us about your home and we'll come back with a fixed solar battery quote, usually within 24 hours. Only your name, email and phone are needed — skip anything you're not sure about and we'll work it out on site."}
      </p>

      <ul class="bqwhy">
        {WHY.map((w) => (
          <li>
            <span class="bqwhy__tick"><Icon name="check" size={15} stroke={3} /></span>
            <div>
              <h3 class="h4">{w.title}</h3>
              <p>{w.text}</p>
            </div>
          </li>
        ))}
      </ul>

      <div class="bqpage__call">
        <p class="lede" style="font-size:.9375rem">Would rather talk it through?</p>
        <a class="btn btn-outline js-call" href={settings.phoneHref}>
          <Icon name="phone" size={16} stroke={2.2} /> Call {settings.phone}
        </a>
      </div>
    </div>

    <div class="bqpage__form reveal reveal-d1">
      <BatteryQuoteForm settings={settings} />
    </div>
  </div>
</section>
