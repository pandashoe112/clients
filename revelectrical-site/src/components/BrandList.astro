---
import Icon from './Icon.astro';
import { img } from '../lib/sanity.js';
const { service, brands = [], settings, navBrands = [] } = Astro.props;

// The logos come from the homepage brand list, which carries artwork but no
// slug. Match them to the brand documents by name so a brand with a landing
// page becomes a link - /brands/evnex/ had no links into it from anywhere in
// the body of the site, only the nav.
const pageFor = (name) => {
  const hit = (navBrands || []).find(
    (b) => b.hasPage && b.slug && b.name && name &&
           b.name.toLowerCase() === String(name).toLowerCase());
  return hit ? `/brands/${hit.slug}/` : null;
};
---
<section class="section bg-paper">
  <div class="wrap brands__inner">
    <div class="reveal">
      <h2 class="h2">{service.brandsHeading}</h2>
      <p class="lede" style="margin-top:20px;max-width:44ch">{service.brandsText}</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn-ink" href="#quote">Talk to us <Icon name="chevron" size={15} stroke={2.6} /></a>
      </div>
    </div>
    <ul class="brandlist reveal reveal-d1">
      {(brands || []).map((b) => {
        const href = pageFor(b.name);
        const mark = b.logo
          ? <img class="brandlogo" src={img(b.logo, 320)} alt={b.name} loading="lazy" />
          : b.name;
        return <li>{href ? <a href={href} title={`${b.name} chargers installed in Melbourne`}>{mark}</a> : mark}</li>;
      })}
    </ul>
  </div>
</section>
