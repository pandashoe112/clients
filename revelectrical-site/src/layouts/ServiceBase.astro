---
import '../styles/global.css';
import '../styles/service.css';
import GtmHead from '../components/GtmHead.astro';
import GtmNoscript from '../components/GtmNoscript.astro';
import SocialMeta from '../components/SocialMeta.astro';
import { businessSchema } from '../lib/schema.js';
const { title, description, canonical, settings, faqs = [], areaServed, noindex = false, crumbs = [] } = Astro.props;

const base = 'https://www.revelectrical.com.au';

// Two blocks: the business itself, and the FAQs so they can win a rich result.
const business = businessSchema(settings, { areaServed });

// BreadcrumbList tells Google the hierarchy and can replace the raw URL in the
// result with a readable trail. Every sub-page is one level under the home
// page, so the crumb list is short - but it has to be there to be used.
const crumbSchema = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Home', url: base + '/' }, ...crumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: c.url.startsWith('http') ? c.url : base + c.url
      }))
    }
  : null;

const faqSchema = faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer }
      }))
    }
  : null;
---
<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <GtmHead />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <SocialMeta title={title} description={description} canonical={canonical} />
  <meta name="google-site-verification" content="gCQaA7Gvgamf6kSc8H14rheeZlhbLhuV5WHO6BZpHUo" />
  <meta name="theme-color" content="#032F35" />
  <link rel="icon" href="/favicon.webp" type="image/webp" />
  <link rel="apple-touch-icon" href="/favicon.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify(business)}></script>
  {crumbSchema && <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)}></script>}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>}
</head>
<body>
  <GtmNoscript />
  <a class="skiplink" href="#main">Skip to main content</a>
  <slot />
  <script>
    import "../scripts/site.js";
  </script>
</body>
</html>
